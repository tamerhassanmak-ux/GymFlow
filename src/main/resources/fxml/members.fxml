<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        prefHeight="600.0"
        prefWidth="1000.0"
        styleClass="members-page"
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.mycompany.lazar_app.controller.MembersController">

    <center>

        <VBox
                spacing="22.0"
                styleClass="members-container">

            <padding>
                <Insets
                        top="30.0"
                        right="30.0"
                        bottom="30.0"
                        left="30.0"/>
            </padding>

            <!-- =================================================
                 HEADER
                 ================================================= -->

            <HBox
                    alignment="CENTER_LEFT"
                    spacing="15.0">

                <VBox spacing="5.0">

                    <Label
                            text="%members.title"
                            styleClass="page-title"/>

                    <Label
                            text="%members.subtitle"
                            styleClass="page-subtitle"/>

                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button
                        mnemonicParsing="false"
                        text="%members.addMember"
                        onAction="#openAddMember"
                        prefHeight="42.0"
                        styleClass="primary-button"/>

            </HBox>


            <!-- =================================================
                 SEARCH / TOOLBAR
                 ================================================= -->

            <HBox
                    alignment="CENTER_LEFT"
                    spacing="10.0"
                    styleClass="members-toolbar">

                <TextField
                        fx:id="searchField"
                        promptText="%members.search"
                        prefHeight="42.0"
                        maxWidth="420.0"
                        HBox.hgrow="ALWAYS"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label
                        fx:id="membersCountLabel"
                        text="%members.count"
                        styleClass="members-count"/>

            </HBox>


            <!-- =================================================
                 MEMBERS TABLE
                 ================================================= -->

            <VBox
                    spacing="0.0"
                    styleClass="table-card"
                    VBox.vgrow="ALWAYS">

                <TableView
                        fx:id="membersTable"
                        VBox.vgrow="ALWAYS"
                        prefHeight="450.0">

                    <columns>

                        <!-- ID -->

                        <TableColumn
                                fx:id="idColumn"
                                text="%members.table.id"
                                prefWidth="65.0"/>


                        <!-- MEMBER NAME -->

                        <TableColumn
                                fx:id="nameColumn"
                                text="%members.table.name"
                                prefWidth="210.0"/>


                        <!-- PHONE -->

                        <TableColumn
                                fx:id="phoneColumn"
                                text="%members.table.phone"
                                prefWidth="160.0"/>


                        <!-- MEMBERSHIP -->

                        <TableColumn
                                fx:id="membershipColumn"
                                text="%members.table.membership"
                                prefWidth="150.0"/>


                        <!-- STATUS -->

                        <TableColumn
                                fx:id="statusColumn"
                                text="%members.table.status"
                                prefWidth="120.0"/>


                        <!-- =====================================
                             ACTIONS
                             View / Edit / Delete
                             ===================================== -->

                        <TableColumn
                                fx:id="actionsColumn"
                                text="%members.table.actions"
                                prefWidth="250.0"
                                sortable="false"
                                resizable="false"/>

                    </columns>

                </TableView>

            </VBox>


            <!-- =================================================
                 FOOTER
                 ================================================= -->

            <HBox alignment="CENTER_LEFT">

                <Label
                        fx:id="showingLabel"
                        text="%members.showing"
                        styleClass="table-footer-text"/>

            </HBox>

        </VBox>

    </center>

</BorderPane>