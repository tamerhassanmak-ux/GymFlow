<?xml version="1.0" encoding="UTF-8"?>
<?import com.mycompany.lazar_app.ui.ResponsiveGrid?>
<?import com.mycompany.lazar_app.ui.ResponsiveRow?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" prefWidth="1100.0" prefHeight="800.0" styleClass="members-page responsive-form" fx:controller="com.mycompany.lazar_app.controller.AddMembershipController" minWidth="0" minHeight="0">
    <top>
        <VBox spacing="6.0" styleClass=" form-header">
            <children>
                <Label fx:id="titleLabel" text="New Membership" styleClass="page-title" />
                <Label fx:id="subtitleLabel" text="Register a new membership for a gym member" styleClass="page-subtitle" />
            </children>
        </VBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" minWidth="0" minHeight="0" styleClass="responsive-content">
            <content>
                <VBox spacing="20.0" styleClass="members-page">
                    <padding>
                        <Insets top="30.0" right="40.0" bottom="30.0" left="40.0" />
                    </padding>
                    <children>
                        <Separator />
                        <ResponsiveGrid hgap="24.0" vgap="10.0">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50.0" hgrow="ALWAYS" />
                                <ColumnConstraints percentWidth="50.0" hgrow="ALWAYS" />
                            </columnConstraints>
                            <children>
                                <Label fx:id="memberLabel" text="Member" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                <Label fx:id="planLabel" text="Membership Plan" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                                <TextField GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2" fx:id="memberSearchField" maxWidth="Infinity" prefHeight="44.0" promptText="بحث بالاسم أو الباركود" />
                                <ComboBox fx:id="memberComboBox" maxWidth="Infinity" prefHeight="44.0" promptText="Select member" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                <ComboBox fx:id="planComboBox" maxWidth="Infinity" prefHeight="44.0" promptText="Select membership plan" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                            </children>
                        </ResponsiveGrid>
                        <ResponsiveGrid hgap="24.0" vgap="10.0">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50.0" hgrow="ALWAYS" />
                                <ColumnConstraints percentWidth="50.0" hgrow="ALWAYS" />
                            </columnConstraints>
                            <children>
                                <Label fx:id="startDateLabel" text="Start Date" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                <Label fx:id="endDateLabel" text="End Date" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                                <DatePicker fx:id="startDatePicker" maxWidth="Infinity" prefHeight="44.0" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                <DatePicker fx:id="endDatePicker" maxWidth="Infinity" prefHeight="44.0" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                            </children>
                        </ResponsiveGrid>
                        <ResponsiveGrid hgap="24.0" vgap="10.0">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50.0" hgrow="ALWAYS" />
                                <ColumnConstraints percentWidth="50.0" hgrow="ALWAYS" />
                            </columnConstraints>
                            <children>
                                <Label fx:id="priceLabel" text="Plan Price" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                <Label fx:id="discountLabel" text="Discount" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                                <TextField fx:id="priceField" maxWidth="Infinity" prefHeight="44.0" editable="false" text="0.00" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                <TextField fx:id="discountField" maxWidth="Infinity" prefHeight="44.0" text="0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                            </children>
                        </ResponsiveGrid>
                        <VBox spacing="8.0" styleClass="dashboard-card">
                            <padding>
                                <Insets top="18.0" right="20.0" bottom="18.0" left="20.0" />
                            </padding>
                            <children>
                                <Label fx:id="finalPriceTitleLabel" text="Final Price" styleClass="card-title" />
                                <Label fx:id="finalPriceLabel" text="0.00" styleClass="card-value" />
                            </children>
                        </VBox>
                        <VBox spacing="8.0" VBox.vgrow="ALWAYS">
                            <children>
                                <Label fx:id="notesLabel" text="Notes" />
                                <TextArea fx:id="notesArea" prefHeight="120.0" maxHeight="Infinity" promptText="Optional notes" wrapText="true" VBox.vgrow="ALWAYS" />
                            </children>
                        </VBox>
                        <Separator />
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <ResponsiveRow fx:id="buttonsContainer" alignment="CENTER_RIGHT" spacing="12.0" styleClass=" persistent-actions">
            <children>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="cancelButton" text="Cancel" prefWidth="130.0" prefHeight="44.0" mnemonicParsing="false" onAction="#cancel" />
                <Button fx:id="saveButton" text="Save Membership" prefWidth="180.0" prefHeight="44.0" mnemonicParsing="false" onAction="#saveMembership" styleClass="primary-button" />
            </children>
        </ResponsiveRow>
    </bottom>
</BorderPane>
