<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane
    fitToWidth="true"
    hbarPolicy="NEVER"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.mycompany.lazar_app.DashboardContentController"
    style="-fx-background-color: transparent;
           -fx-background: transparent;">

    <content>

        <VBox
            spacing="20.0"
            alignment="TOP_LEFT"
            style="-fx-background-color: #F4F7FB;">

            <padding>
                <Insets
                    top="25.0"
                    right="25.0"
                    bottom="30.0"
                    left="25.0"/>
            </padding>

            <children>

                <!-- ================================================= -->
                <!-- HEADER                                            -->
                <!-- ================================================= -->

                <HBox
                    alignment="CENTER_LEFT"
                    spacing="15.0">

                    <VBox spacing="4.0">

                        <Label
                            text="%dashboard.welcome"
                            style="-fx-font-size: 26px;
                                   -fx-font-weight: bold;
                                   -fx-text-fill: #111827;"/>

                        <Label
                            text="%dashboard.subtitle"
                            style="-fx-font-size: 13px;
                                   -fx-text-fill: #64748B;"/>

                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <VBox
                        spacing="3.0"
                        alignment="CENTER_RIGHT">

                        <Label
                            fx:id="currentDateLabel"
                            text="-"
                            style="-fx-font-size: 13px;
                                   -fx-font-weight: bold;
                                   -fx-text-fill: #374151;"/>

                        <Label
                            text="%app.title"
                            style="-fx-font-size: 11px;
                                   -fx-text-fill: #94A3B8;"/>

                    </VBox>

                </HBox>


                <!-- ================================================= -->
                <!-- KPI CARDS                                         -->
                <!-- ================================================= -->

                <HBox spacing="15.0">


                    <!-- ACTIVE MEMBERS -->

                    <VBox
                        spacing="7.0"
                        prefHeight="132.0"
                        HBox.hgrow="ALWAYS"
                        style="-fx-background-color: white;
                               -fx-background-radius: 14;
                               -fx-padding: 18;
                               -fx-effect: dropshadow(
                                   gaussian,
                                   rgba(15,23,42,0.07),
                                   12,0,0,3
                               );">

                        <HBox alignment="CENTER_LEFT">

                            <Label
                                text="%dashboard.activeMembers"
                                style="-fx-font-size: 13px;
                                       -fx-font-weight: bold;
                                       -fx-text-fill: #64748B;"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <StackPane
                                prefWidth="34"
                                prefHeight="34"
                                minWidth="34"
                                minHeight="34"
                                style="-fx-background-color: #EFF6FF;
                                       -fx-background-radius: 10;">

                                <Label
                                    text="M"
                                    style="-fx-font-size: 13px;
                                           -fx-font-weight: bold;
                                           -fx-text-fill: #2563EB;"/>

                            </StackPane>

                        </HBox>

                        <Label
                            fx:id="activeMembersValueLabel"
                            text="0"
                            style="-fx-font-size: 30px;
                                   -fx-font-weight: bold;
                                   -fx-text-fill: #111827;"/>

                        <HBox
                            spacing="5"
                            alignment="CENTER_LEFT">

                            <Label
                                fx:id="memberGrowthPercentageLabel"
                                text="0%"
                                style="-fx-font-size: 11px;
                                       -fx-text-fill: #16A34A;
                                       -fx-font-weight: bold;"/>

                            <Label
                                text="%dashboard.lastMonth"
                                style="-fx-font-size: 10px;
                                       -fx-text-fill: #94A3B8;"/>

                        </HBox>

                    </VBox>


                    <!-- TODAY CHECK-INS -->

                    <VBox
                        spacing="7.0"
                        prefHeight="132.0"
                        HBox.hgrow="ALWAYS"
                        style="-fx-background-color: white;
                               -fx-background-radius: 14;
                               -fx-padding: 18;
                               -fx-effect: dropshadow(
                                   gaussian,
                                   rgba(15,23,42,0.07),
                                   12,0,0,3
                               );">

                        <HBox alignment="CENTER_LEFT">

                            <Label
                                text="%dashboard.checkins"
                                style="-fx-font-size: 13px;
                                       -fx-font-weight: bold;
                                       -fx-text-fill: #64748B;"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <StackPane
                                prefWidth="34"
                                prefHeight="34"
                                minWidth="34"
                                minHeight="34"
                                style="-fx-background-color: #ECFDF5;
                                       -fx-background-radius: 10;">

                                <Label
                                    text="IN"
                                    style="-fx-font-size: 10px;
                                           -fx-font-weight: bold;
                                           -fx-text-fill: #059669;"/>

                            </StackPane>

                        </HBox>

                        <Label
                            fx:id="todayCheckInsValueLabel"
                            text="0"
                            style="-fx-font-size: 30px;
                                   -fx-font-weight: bold;
                                   -fx-text-fill: #111827;"/>

                        <Label
                            text="%dashboard.today"
                            style="-fx-font-size: 10px;
                                   -fx-text-fill: #94A3B8;"/>

                    </VBox>


                    <!-- EXPIRING -->

                    <VBox
                        spacing="7.0"
                        prefHeight="132.0"
                        HBox.hgrow="ALWAYS"
                        style="-fx-background-color: white;
                               -fx-background-radius: 14;
                               -fx-padding: 18;
                               -fx-effect: dropshadow(
                                   gaussian,
                                   rgba(15,23,42,0.07),
                                   12,0,0,3
                               );">

                        <HBox alignment="CENTER_LEFT">

                            <Label
                                text="%dashboard.expiring"
                                style="-fx-font-size: 13px;
                                       -fx-font-weight: bold;
                                       -fx-text-fill: #64748B;"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <StackPane
                                prefWidth="34"
                                prefHeight="34"
                                minWidth="34"
                                minHeight="34"
                                style="-fx-background-color: #FFF7ED;
                                       -fx-background-radius: 10;">

                                <Label
                                    text="!"
                                    style="-fx-font-size: 16px;
                                           -fx-font-weight: bold;
                                           -fx-text-fill: #F97316;"/>

                            </StackPane>

                        </HBox>

                        <Label
                            fx:id="expiringMembershipsValueLabel"
                            text="0"
                            style="-fx-font-size: 30px;
                                   -fx-font-weight: bold;
                                   -fx-text-fill: #111827;"/>

                        <Label
                            text="%dashboard.next7days"
                            style="-fx-font-size: 11px;
                                   -fx-text-fill: #F97316;
                                   -fx-font-weight: bold;"/>

                    </VBox>


                    <!-- MONTHLY REVENUE -->

                    <VBox
                        spacing="7.0"
                        prefHeight="132.0"
                        HBox.hgrow="ALWAYS"
                        style="-fx-background-color: white;
                               -fx-background-radius: 14;
                               -fx-padding: 18;
                               -fx-effect: dropshadow(
                                   gaussian,
                                   rgba(15,23,42,0.07),
                                   12,0,0,3
                               );">

                        <HBox alignment="CENTER_LEFT">

                            <Label
                                text="%dashboard.revenue"
                                style="-fx-font-size: 13px;
                                       -fx-font-weight: bold;
                                       -fx-text-fill: #64748B;"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <StackPane
                                prefWidth="34"
                                prefHeight="34"
                                minWidth="34"
                                minHeight="34"
                                style="-fx-background-color: #F0FDF4;
                                       -fx-background-radius: 10;">

                                <Label
                                    text="EGP"
                                    style="-fx-font-size: 12px;
                                           -fx-font-weight: bold;
                                           -fx-text-fill: #16A34A;"/>

                            </StackPane>

                        </HBox>

                        <Label
                            fx:id="monthlyRevenueValueLabel"
                            text="0 EGP"
                            style="-fx-font-size: 25px;
                                   -fx-font-weight: bold;
                                   -fx-text-fill: #111827;"/>

                        <HBox
                            spacing="5"
                            alignment="CENTER_LEFT">

                            <Label
                                fx:id="revenueChangePercentageLabel"
                                text="0%"
                                style="-fx-font-size: 11px;
                                       -fx-text-fill: #16A34A;
                                       -fx-font-weight: bold;"/>

                            <Label
                                text="%dashboard.lastMonth"
                                style="-fx-font-size: 10px;
                                       -fx-text-fill: #94A3B8;"/>

                        </HBox>

                    </VBox>

                </HBox>


                <!-- ================================================= -->
                <!-- CHARTS                                            -->
                <!-- ================================================= -->

                <HBox
                    spacing="15.0"
                    prefHeight="360.0">


                    <!-- REVENUE / EXPENSES -->

                    <VBox
                        spacing="8.0"
                        HBox.hgrow="ALWAYS"
                        style="-fx-background-color: white;
                               -fx-background-radius: 14;
                               -fx-padding: 18;
                               -fx-effect: dropshadow(
                                   gaussian,
                                   rgba(15,23,42,0.06),
                                   12,0,0,3
                               );">

                        <HBox alignment="CENTER_LEFT">

                            <VBox spacing="3">

                                <Label
                                    text="%dashboard.revenueExpenses"
                                    style="-fx-font-size: 16px;
                                           -fx-font-weight: bold;
                                           -fx-text-fill: #111827;"/>

                                <Label
                                    text="%dashboard.last6months"
                                    style="-fx-font-size: 10px;
                                           -fx-text-fill: #94A3B8;"/>

                            </VBox>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label
                                text="EGP"
                                style="-fx-background-color: #F8FAFC;
                                       -fx-background-radius: 8;
                                       -fx-padding: 5 9;
                                       -fx-font-size: 10px;
                                       -fx-font-weight: bold;
                                       -fx-text-fill: #64748B;"/>

                        </HBox>

                        <BarChart
                            fx:id="revenueChart"
                            animated="false"
                            legendVisible="true"
                            categoryGap="15"
                            barGap="4"
                            VBox.vgrow="ALWAYS">

                            <xAxis>
                                <CategoryAxis
                                    label="%chart.month"
                                    tickLabelGap="5"/>
                            </xAxis>

                            <yAxis>
                                <NumberAxis
                                    label="EGP"
                                    forceZeroInRange="true"/>
                            </yAxis>

                        </BarChart>

                    </VBox>


                    <!-- MEMBER GROWTH -->

                    <VBox
                        spacing="8.0"
                        HBox.hgrow="ALWAYS"
                        style="-fx-background-color: white;
                               -fx-background-radius: 14;
                               -fx-padding: 18;
                               -fx-effect: dropshadow(
                                   gaussian,
                                   rgba(15,23,42,0.06),
                                   12,0,0,3
                               );">

                        <HBox alignment="CENTER_LEFT">

                            <VBox spacing="3">

                                <Label
                                    text="%dashboard.memberGrowth"
                                    style="-fx-font-size: 16px;
                                           -fx-font-weight: bold;
                                           -fx-text-fill: #111827;"/>

                                <Label
                                    text="%dashboard.last6months"
                                    style="-fx-font-size: 10px;
                                           -fx-text-fill: #94A3B8;"/>

                            </VBox>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label
                                fx:id="activeMembersChartValueLabel"
                                text="0"
                                style="-fx-background-color: #EFF6FF;
                                       -fx-background-radius: 8;
                                       -fx-padding: 5 9;
                                       -fx-font-size: 11px;
                                       -fx-font-weight: bold;
                                       -fx-text-fill: #2563EB;"/>

                        </HBox>

                        <LineChart
                            fx:id="memberGrowthChart"
                            animated="false"
                            createSymbols="true"
                            legendVisible="false"
                            VBox.vgrow="ALWAYS">

                            <xAxis>
                                <CategoryAxis
                                    label="%chart.month"/>
                            </xAxis>

                            <yAxis>
                                <NumberAxis
                                    label="%chart.members"
                                    forceZeroInRange="true"/>
                            </yAxis>

                        </LineChart>

                    </VBox>


                    <!-- MEMBERSHIP TYPES -->

                    <VBox
                        spacing="8.0"
                        prefWidth="300.0"
                        style="-fx-background-color: white;
                               -fx-background-radius: 14;
                               -fx-padding: 18;
                               -fx-effect: dropshadow(
                                   gaussian,
                                   rgba(15,23,42,0.06),
                                   12,0,0,3
                               );">

                        <HBox alignment="CENTER_LEFT">

                            <VBox spacing="3">

                                <Label
                                    text="%dashboard.membershipTypes"
                                    style="-fx-font-size: 16px;
                                           -fx-font-weight: bold;
                                           -fx-text-fill: #111827;"/>

                                <Label
                                    text="%dashboard.totalMembers"
                                    style="-fx-font-size: 10px;
                                           -fx-text-fill: #94A3B8;"/>

                            </VBox>

                        </HBox>

                        <PieChart
                            fx:id="membershipChart"
                            labelsVisible="true"
                            legendVisible="true"
                            clockwise="true"
                            startAngle="90"
                            VBox.vgrow="ALWAYS"/>

                    </VBox>

                </HBox>


                <!-- ================================================= -->
                <!-- LOWER DASHBOARD                                   -->
                <!-- ================================================= -->

                <HBox
                    spacing="15.0"
                    prefHeight="300.0">


                    <!-- RECENT MEMBERS -->

                    <VBox
                        spacing="11.0"
                        HBox.hgrow="ALWAYS"
                        style="-fx-background-color: white;
                               -fx-background-radius: 14;
                               -fx-padding: 18;
                               -fx-effect: dropshadow(
                                   gaussian,
                                   rgba(15,23,42,0.06),
                                   12,0,0,3
                               );">

                        <HBox alignment="CENTER_LEFT">

                            <VBox spacing="2">

                                <Label
                                    text="%dashboard.recentMembers"
                                    style="-fx-font-size: 16px;
                                           -fx-font-weight: bold;
                                           -fx-text-fill: #111827;"/>

                                <Label
                                    text="%dashboard.totalMembers"
                                    style="-fx-font-size: 9px;
                                           -fx-text-fill: #94A3B8;"/>

                            </VBox>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label
                                text="%dashboard.viewAll"
                                style="-fx-font-size: 10px;
                                       -fx-font-weight: bold;
                                       -fx-text-fill: #2563EB;"/>

                        </HBox>

                        <VBox
                            fx:id="recentMembersContainer"
                            spacing="8.0"
                            VBox.vgrow="ALWAYS"/>

                    </VBox>


                    <!-- UPCOMING EXPIRATIONS -->

                    <VBox
                        spacing="11.0"
                        HBox.hgrow="ALWAYS"
                        style="-fx-background-color: white;
                               -fx-background-radius: 14;
                               -fx-padding: 18;
                               -fx-effect: dropshadow(
                                   gaussian,
                                   rgba(15,23,42,0.06),
                                   12,0,0,3
                               );">

                        <HBox alignment="CENTER_LEFT">

                            <VBox spacing="2">

                                <Label
                                    text="%dashboard.upcomingExpirations"
                                    style="-fx-font-size: 16px;
                                           -fx-font-weight: bold;
                                           -fx-text-fill: #111827;"/>

                                <Label
                                    text="%dashboard.next7days"
                                    style="-fx-font-size: 9px;
                                           -fx-text-fill: #94A3B8;"/>

                            </VBox>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label
                                text="%dashboard.viewAll"
                                style="-fx-font-size: 10px;
                                       -fx-font-weight: bold;
                                       -fx-text-fill: #2563EB;"/>

                        </HBox>

                        <VBox
                            fx:id="expirationsContainer"
                            spacing="8.0"
                            VBox.vgrow="ALWAYS"/>

                    </VBox>


                    <!-- RECENT PAYMENTS -->

                    <VBox
                        spacing="11.0"
                        HBox.hgrow="ALWAYS"
                        style="-fx-background-color: white;
                               -fx-background-radius: 14;
                               -fx-padding: 18;
                               -fx-effect: dropshadow(
                                   gaussian,
                                   rgba(15,23,42,0.06),
                                   12,0,0,3
                               );">

                        <HBox alignment="CENTER_LEFT">

                            <VBox spacing="2">

                                <Label
                                    text="%dashboard.recentPayments"
                                    style="-fx-font-size: 16px;
                                           -fx-font-weight: bold;
                                           -fx-text-fill: #111827;"/>

                                <Label
                                    text="%dashboard.revenue"
                                    style="-fx-font-size: 9px;
                                           -fx-text-fill: #94A3B8;"/>

                            </VBox>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label
                                text="%dashboard.viewAll"
                                style="-fx-font-size: 10px;
                                       -fx-font-weight: bold;
                                       -fx-text-fill: #2563EB;"/>

                        </HBox>

                        <VBox
                            fx:id="recentPaymentsContainer"
                            spacing="8.0"
                            VBox.vgrow="ALWAYS"/>

                    </VBox>

                </HBox>

            </children>

        </VBox>

    </content>

</ScrollPane>