<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane
    prefHeight="700.0"
    prefWidth="950.0"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.mycompany.lazar_app.controller.CheckinController"
    style="-fx-background-color: #F5F7FA;">

    <children>

        <VBox
            spacing="20"
            AnchorPane.topAnchor="0"
            AnchorPane.bottomAnchor="0"
            AnchorPane.leftAnchor="0"
            AnchorPane.rightAnchor="0">

            <padding>
                <Insets top="25" right="30" bottom="25" left="30"/>
            </padding>


            <!-- HEADER -->

            <HBox alignment="CENTER_LEFT" spacing="15">

                <VBox spacing="5">

                    <Label
                        text="%checkin.title"
                        style="-fx-font-size:26px;
                               -fx-font-weight:bold;
                               -fx-text-fill:#1F2937;"/>

                    <Label
                        text="%checkin.subtitle"
                        style="-fx-font-size:13px;
                               -fx-text-fill:#6B7280;"/>

                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button
                    text="%checkin.addCheckin"
                    mnemonicParsing="false"
                    onAction="#openCheckinDialog"
                    style="-fx-background-color:#F97316;
                           -fx-text-fill:white;
                           -fx-font-size:14px;
                           -fx-font-weight:bold;
                           -fx-background-radius:8;
                           -fx-padding:10 20;
                           -fx-cursor:hand;"/>

            </HBox>


            <!-- STATISTICS -->

            <HBox spacing="15">

                <VBox
                    spacing="8"
                    prefWidth="200"
                    HBox.hgrow="ALWAYS"
                    style="-fx-background-color:white;
                           -fx-background-radius:10;
                           -fx-padding:18;">

                    <Label
                        text="%checkin.stats.today"
                        style="-fx-text-fill:#6B7280;"/>

                    <Label
                        fx:id="todayCheckinsLabel"
                        text="0"
                        style="-fx-font-size:26px;
                               -fx-font-weight:bold;"/>

                </VBox>


                <VBox
                    spacing="8"
                    prefWidth="200"
                    HBox.hgrow="ALWAYS"
                    style="-fx-background-color:white;
                           -fx-background-radius:10;
                           -fx-padding:18;">

                    <Label
                        text="%checkin.stats.currentlyInside"
                        style="-fx-text-fill:#6B7280;"/>

                    <Label
                        fx:id="currentlyInsideLabel"
                        text="0"
                        style="-fx-font-size:26px;
                               -fx-font-weight:bold;
                               -fx-text-fill:#16A34A;"/>

                </VBox>


                <VBox
                    spacing="8"
                    prefWidth="200"
                    HBox.hgrow="ALWAYS"
                    style="-fx-background-color:white;
                           -fx-background-radius:10;
                           -fx-padding:18;">

                    <Label
                        text="%checkin.stats.checkedOut"
                        style="-fx-text-fill:#6B7280;"/>

                    <Label
                        fx:id="checkedOutLabel"
                        text="0"
                        style="-fx-font-size:26px;
                               -fx-font-weight:bold;
                               -fx-text-fill:#2563EB;"/>

                </VBox>


                <VBox
                    spacing="8"
                    prefWidth="200"
                    HBox.hgrow="ALWAYS"
                    style="-fx-background-color:white;
                           -fx-background-radius:10;
                           -fx-padding:18;">

                    <Label
                        text="%checkin.stats.activeMembers"
                        style="-fx-text-fill:#6B7280;"/>

                    <Label
                        fx:id="activeMembersLabel"
                        text="0"
                        style="-fx-font-size:26px;
                               -fx-font-weight:bold;
                               -fx-text-fill:#F97316;"/>

                </VBox>

            </HBox>


            <!-- SEARCH -->

            <HBox
                alignment="CENTER_LEFT"
                spacing="10">

                <TextField
                    fx:id="searchField"
                    promptText="%checkin.search"
                    prefHeight="40"
                    prefWidth="400"/>

                <Button
                    text="%common.search"
                    mnemonicParsing="false"
                    onAction="#search"
                    prefHeight="40"
                    style="-fx-background-color:#1F2937;
                           -fx-text-fill:white;
                           -fx-background-radius:7;
                           -fx-padding:0 20;
                           -fx-cursor:hand;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button
                    text="%common.refresh"
                    mnemonicParsing="false"
                    onAction="#refresh"
                    prefHeight="40"
                    style="-fx-background-color:white;
                           -fx-text-fill:#374151;
                           -fx-border-color:#D1D5DB;
                           -fx-border-radius:7;
                           -fx-background-radius:7;
                           -fx-padding:0 18;
                           -fx-cursor:hand;"/>

            </HBox>


            <!-- TABLE -->

            <VBox
                spacing="15"
                VBox.vgrow="ALWAYS"
                style="-fx-background-color:white;
                       -fx-background-radius:10;
                       -fx-padding:20;">

                <HBox alignment="CENTER_LEFT">

                    <Label
                        text="%checkin.list"
                        style="-fx-font-size:17px;
                               -fx-font-weight:bold;"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Label
                        fx:id="attendanceCountLabel"
                        text="0"
                        style="-fx-text-fill:#6B7280;"/>

                </HBox>


                <TableView
                    fx:id="checkinTable"
                    VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn
                            fx:id="idColumn"
                            text="%checkin.table.id"
                            prefWidth="55"/>

                        <TableColumn
                            fx:id="memberColumn"
                            text="%checkin.table.member"
                            prefWidth="180"/>

                        <TableColumn
                            fx:id="phoneColumn"
                            text="%checkin.table.phone"
                            prefWidth="120"/>

                        <TableColumn
                            fx:id="membershipColumn"
                            text="%checkin.table.membership"
                            prefWidth="120"/>

                        <TableColumn
                            fx:id="checkinTimeColumn"
                            text="%checkin.table.checkinTime"
                            prefWidth="145"/>

                        <TableColumn
                            fx:id="checkoutTimeColumn"
                            text="%checkin.table.checkoutTime"
                            prefWidth="145"/>

                        <TableColumn
                            fx:id="statusColumn"
                            text="%checkin.table.status"
                            prefWidth="100"/>

                        <TableColumn
                            fx:id="actionsColumn"
                            text="%checkin.table.actions"
                            prefWidth="220"/>

                    </columns>

                </TableView>

            </VBox>

        </VBox>

    </children>

</AnchorPane>