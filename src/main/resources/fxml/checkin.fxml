<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane
    prefHeight="700.0"
    prefWidth="950.0"
    minHeight="0.0"
    minWidth="0.0"
    maxHeight="Infinity"
    maxWidth="Infinity"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.mycompany.lazar_app.controller.CheckinController" styleClass="app-page"
    >

    <children>

        <VBox
            spacing="20"
            AnchorPane.topAnchor="0"
            AnchorPane.bottomAnchor="0"
            AnchorPane.leftAnchor="0"
            AnchorPane.rightAnchor="0">

            <padding>
                <Insets top="25" right="30" bottom="25" left="30"/>
            </padding>


            <!-- HEADER -->

            <HBox alignment="CENTER_LEFT" spacing="15">

                <VBox spacing="5">

                    <Label
                        text="%checkin.title"
                         styleClass="page-title"/>

                    <Label
                        text="%checkin.subtitle"
                        style="-fx-font-size:13px;
                               " styleClass="ui-muted"/>

                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button
                    text="%checkin.addCheckin"
                    mnemonicParsing="false"
                    onAction="#openCheckinDialog"
                    style="-fx-padding: 10 20; -fx-cursor: hand;" styleClass="primary-button"/>

            </HBox>


            <!-- STATISTICS -->

            <HBox spacing="15">

                <VBox
                    spacing="8"
                    prefWidth="200"
                    HBox.hgrow="ALWAYS"
                    style="-fx-background-color:white;
                           -fx-background-radius:10;
                           -fx-padding:18;">

                    <Label
                        text="%checkin.stats.today" styleClass="ui-muted"/>

                    <Label
                        fx:id="todayCheckinsLabel"
                        text="0"
                        style="-fx-font-size:26px;
                               -fx-font-weight:bold;"/>

                </VBox>


                <VBox
                    spacing="8"
                    prefWidth="200"
                    HBox.hgrow="ALWAYS"
                    style="-fx-background-color:white;
                           -fx-background-radius:10;
                           -fx-padding:18;">

                    <Label
                        text="%checkin.stats.currentlyInside" styleClass="ui-muted"/>

                    <Label
                        fx:id="currentlyInsideLabel"
                        text="0"
                        style="-fx-font-size:26px;
                               -fx-font-weight:bold;
                               -fx-text-fill:#16A34A;"/>

                </VBox>


                <VBox
                    spacing="8"
                    prefWidth="200"
                    HBox.hgrow="ALWAYS"
                    style="-fx-background-color:white;
                           -fx-background-radius:10;
                           -fx-padding:18;">

                    <Label
                        text="%checkin.stats.checkedOut" styleClass="ui-muted"/>

                    <Label
                        fx:id="checkedOutLabel"
                        text="0"
                        style="-fx-font-size:26px;
                               -fx-font-weight:bold;
                               -fx-text-fill:#2563EB;"/>

                </VBox>


                <VBox
                    spacing="8"
                    prefWidth="200"
                    HBox.hgrow="ALWAYS"
                    style="-fx-background-color:white;
                           -fx-background-radius:10;
                           -fx-padding:18;">

                    <Label
                        text="%checkin.stats.activeMembers" styleClass="ui-muted"/>

                    <Label
                        fx:id="activeMembersLabel"
                        text="0"
                        style="-fx-font-size:26px;
                               -fx-font-weight:bold;
                               -fx-text-fill:#F97316;"/>

                </VBox>

            </HBox>


            <!-- SEARCH -->

            <HBox
                alignment="CENTER_LEFT"
                spacing="10">

                <TextField
                    fx:id="searchField"
                    promptText="%checkin.search"
                    prefHeight="40"
                    prefWidth="400"/>

                <Button
                    text="%common.search"
                    mnemonicParsing="false"
                    onAction="#search"
                    prefHeight="40"
                    style="-fx-padding: 0 20; -fx-cursor: hand;" styleClass="neutral-button"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button
                    text="%common.refresh"
                    mnemonicParsing="false"
                    onAction="#refresh"
                    prefHeight="40"
                    style="-fx-padding: 0 18; -fx-cursor: hand;" styleClass="secondary-button"/>

            </HBox>


            <!-- TABLE -->

            <VBox
                spacing="15"
                VBox.vgrow="ALWAYS"
                style="-fx-background-color:white;
                       -fx-background-radius:10;
                       -fx-padding:20;">

                <HBox alignment="CENTER_LEFT">

                    <Label
                        text="%checkin.list"
                        style="-fx-font-size:17px;
                               -fx-font-weight:bold;"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Label
                        fx:id="attendanceCountLabel"
                        text="0" styleClass="ui-muted"/>

                </HBox>


                <TableView
                    fx:id="checkinTable"
                    VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn
                            fx:id="idColumn"
                            text="%checkin.table.memberCode"
                            minWidth="130"
                            prefWidth="150"/>

                        <TableColumn
                            fx:id="memberColumn"
                            text="%checkin.table.member"
                            prefWidth="180"/>

                        <TableColumn
                            fx:id="phoneColumn"
                            text="%checkin.table.phone"
                            prefWidth="120"/>

                        <TableColumn
                            fx:id="membershipColumn"
                            text="%checkin.table.membership"
                            prefWidth="120"/>

                        <TableColumn
                            fx:id="checkinTimeColumn"
                            text="%checkin.table.checkinTime"
                            prefWidth="145"/>

                        <TableColumn
                            fx:id="checkoutTimeColumn"
                            text="%checkin.table.checkoutTime"
                            prefWidth="145"/>

                        <TableColumn
                            fx:id="statusColumn"
                            text="%checkin.table.status"
                            prefWidth="100"/>

                        <TableColumn
                            fx:id="actionsColumn"
                            text="%checkin.table.actions"
                            prefWidth="350" minWidth="330"/>

                    </columns>

                </TableView>

                <HBox fx:id="paginationHost"/>

            </VBox>

        </VBox>

    </children>

</AnchorPane>