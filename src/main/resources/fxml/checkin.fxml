<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import com.mycompany.lazar_app.ui.ResponsiveRow?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" prefHeight="700.0" prefWidth="950.0" maxHeight="Infinity" maxWidth="Infinity" fx:controller="com.mycompany.lazar_app.controller.CheckinController" styleClass="app-page" minWidth="0" minHeight="0">
    <top>
        <ResponsiveRow alignment="CENTER_LEFT" spacing="15">
            <VBox spacing="5">
                <Label text="%checkin.title" styleClass="page-title" />
                <Label text="%checkin.subtitle" style="-fx-font-size:13px;                                " styleClass="ui-muted" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="%checkin.addCheckin" mnemonicParsing="false" onAction="#openCheckinDialog" style="-fx-padding: 10 20; -fx-cursor: hand;" styleClass="primary-button" />
        </ResponsiveRow>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" minWidth="0" minHeight="0" styleClass="responsive-content">
            <content>
                <VBox spacing="20">
                    <padding>
                        <Insets top="25" right="30" bottom="25" left="30" />
                    </padding>
                    <ResponsiveRow spacing="15">
                        <VBox spacing="8" prefWidth="200" HBox.hgrow="ALWAYS" style="-fx-background-color:white;                            -fx-background-radius:10;                            -fx-padding:18;">
                            <Label text="%checkin.stats.today" styleClass="ui-muted" />
                            <Label fx:id="todayCheckinsLabel" text="0" style="-fx-font-size:26px;                                -fx-font-weight:bold;" />
                        </VBox>
                        <VBox spacing="8" prefWidth="200" HBox.hgrow="ALWAYS" style="-fx-background-color:white;                            -fx-background-radius:10;                            -fx-padding:18;">
                            <Label text="%checkin.stats.currentlyInside" styleClass="ui-muted" />
                            <Label fx:id="currentlyInsideLabel" text="0" style="-fx-font-size:26px;                                -fx-font-weight:bold;                                -fx-text-fill:#16A34A;" />
                        </VBox>
                        <VBox spacing="8" prefWidth="200" HBox.hgrow="ALWAYS" style="-fx-background-color:white;                            -fx-background-radius:10;                            -fx-padding:18;">
                            <Label text="%checkin.stats.checkedOut" styleClass="ui-muted" />
                            <Label fx:id="checkedOutLabel" text="0" style="-fx-font-size:26px;                                -fx-font-weight:bold;                                -fx-text-fill:#2563EB;" />
                        </VBox>
                        <VBox spacing="8" prefWidth="200" HBox.hgrow="ALWAYS" style="-fx-background-color:white;                            -fx-background-radius:10;                            -fx-padding:18;">
                            <Label text="%checkin.stats.activeMembers" styleClass="ui-muted" />
                            <Label fx:id="activeMembersLabel" text="0" style="-fx-font-size:26px;                                -fx-font-weight:bold;                                -fx-text-fill:#F97316;" />
                        </VBox>
                    </ResponsiveRow>
                    <ResponsiveRow alignment="CENTER_LEFT" spacing="10">
                        <TextField fx:id="searchField" promptText="%checkin.search" prefHeight="40" prefWidth="400" />
                        <Button text="%common.search" mnemonicParsing="false" onAction="#search" prefHeight="40" style="-fx-padding: 0 20; -fx-cursor: hand;" styleClass="neutral-button" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button text="%common.refresh" mnemonicParsing="false" onAction="#refresh" prefHeight="40" style="-fx-padding: 0 18; -fx-cursor: hand;" styleClass="secondary-button" />
                    </ResponsiveRow>
                    <VBox spacing="15" VBox.vgrow="ALWAYS" style="-fx-background-color:white;                        -fx-background-radius:10;                        -fx-padding:20;">
                        <ResponsiveRow alignment="CENTER_LEFT">
                            <Label text="%checkin.list" style="-fx-font-size:17px;                                -fx-font-weight:bold;" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="attendanceCountLabel" text="0" styleClass="ui-muted" />
                        </ResponsiveRow>
                        <TableView fx:id="checkinTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="idColumn" text="%checkin.table.memberCode" minWidth="130" prefWidth="150" />
                                <TableColumn fx:id="memberColumn" text="%checkin.table.member" prefWidth="180" />
                                <TableColumn fx:id="phoneColumn" text="%checkin.table.phone" prefWidth="120" />
                                <TableColumn fx:id="membershipColumn" text="%checkin.table.membership" prefWidth="120" />
                                <TableColumn fx:id="checkinTimeColumn" text="%checkin.table.checkinTime" prefWidth="145" />
                                <TableColumn fx:id="checkoutTimeColumn" text="%checkin.table.checkoutTime" prefWidth="145" />
                                <TableColumn fx:id="statusColumn" text="%checkin.table.status" prefWidth="100" />
                                <TableColumn fx:id="actionsColumn" text="%checkin.table.actions" prefWidth="350" minWidth="330" />
                            </columns>
                        </TableView>
                        <ResponsiveRow fx:id="paginationHost" />
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
