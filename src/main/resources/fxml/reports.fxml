<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane
        prefHeight="700.0"
        prefWidth="950.0"
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.mycompany.lazar_app.controller.ReportsController"
        style="-fx-background-color: #F5F7FA;">

    <children>

        <ScrollPane
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                style="-fx-background-color: transparent;
                       -fx-background: #F5F7FA;"
                AnchorPane.topAnchor="0.0"
                AnchorPane.rightAnchor="0.0"
                AnchorPane.bottomAnchor="0.0"
                AnchorPane.leftAnchor="0.0">

            <content>

                <VBox
                        spacing="20"
                        style="-fx-background-color: #F5F7FA;">

                    <padding>
                        <Insets
                                top="25"
                                right="30"
                                bottom="25"
                                left="30"/>
                    </padding>


                    <!-- ================================================= -->
                    <!-- HEADER                                            -->
                    <!-- ================================================= -->

                    <HBox
                            alignment="CENTER_LEFT"
                            spacing="15">

                        <VBox spacing="5">

                            <Label
                                    fx:id="titleLabel"
                                    text="Reports &amp; Analytics"
                                    style="-fx-font-size: 26px;
                                           -fx-font-weight: bold;
                                           -fx-text-fill: #1F2937;"/>

                            <Label
                                    fx:id="subtitleLabel"
                                    text="Monitor gym financial and membership performance"
                                    style="-fx-font-size: 13px;
                                           -fx-text-fill: #6B7280;"/>

                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Button
                                fx:id="exportButton"
                                text="Export Report"
                                style="-fx-background-color: #F97316;
                                       -fx-text-fill: white;
                                       -fx-font-size: 14px;
                                       -fx-font-weight: bold;
                                       -fx-background-radius: 8;
                                       -fx-padding: 10 20;
                                       -fx-cursor: hand;"/>

                    </HBox>


                    <!-- ================================================= -->
                    <!-- FILTERS                                           -->
                    <!-- ================================================= -->

                    <HBox
                            alignment="CENTER_LEFT"
                            spacing="10"
                            style="-fx-background-color: white;
                                   -fx-background-radius: 10;
                                   -fx-padding: 15;">

                        <Label
                                fx:id="reportLabel"
                                text="Report:"
                                style="-fx-font-weight: bold;
                                       -fx-text-fill: #374151;"/>

                        <ComboBox
                                fx:id="reportTypeComboBox"
                                promptText="Report Type"
                                prefWidth="170"/>

                        <Label
                                fx:id="fromLabel"
                                text="From:"
                                style="-fx-text-fill: #6B7280;"/>

                        <DatePicker
                                fx:id="fromDatePicker"
                                prefWidth="145"/>

                        <Label
                                fx:id="toLabel"
                                text="To:"
                                style="-fx-text-fill: #6B7280;"/>

                        <DatePicker
                                fx:id="toDatePicker"
                                prefWidth="145"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Button
                                fx:id="generateButton"
                                text="Generate"
                                style="-fx-background-color: #1F2937;
                                       -fx-text-fill: white;
                                       -fx-font-weight: bold;
                                       -fx-background-radius: 7;
                                       -fx-padding: 8 20;
                                       -fx-cursor: hand;"/>

                    </HBox>


                    <!-- ================================================= -->
                    <!-- KPI CARDS                                         -->
                    <!-- ================================================= -->

                    <HBox spacing="15">

                        <!-- ================= REVENUE ================= -->

                        <VBox
                                spacing="8"
                                HBox.hgrow="ALWAYS"
                                prefWidth="210"
                                style="-fx-background-color: white;
                                       -fx-background-radius: 10;
                                       -fx-padding: 18;
                                       -fx-effect: dropshadow(
                                           gaussian,
                                           rgba(0,0,0,0.07),
                                           8,0,0,2
                                       );">

                            <Label
                                    fx:id="totalRevenueTitleLabel"
                                    text="Total Revenue"
                                    style="-fx-font-size: 13px;
                                           -fx-text-fill: #6B7280;"/>

                            <Label
                                    fx:id="totalRevenueValueLabel"
                                    text="0.00 EGP"
                                    style="-fx-font-size: 22px;
                                           -fx-font-weight: bold;
                                           -fx-text-fill: #16A34A;"/>

                            <Label
                                    fx:id="revenueChangeLabel"
                                    text="Realized revenue for selected period"
                                    wrapText="true"
                                    style="-fx-font-size: 11px;
                                           -fx-text-fill: #16A34A;"/>

                        </VBox>


                        <!-- ================= EXPENSES ================= -->

                        <VBox
                                spacing="8"
                                HBox.hgrow="ALWAYS"
                                prefWidth="210"
                                style="-fx-background-color: white;
                                       -fx-background-radius: 10;
                                       -fx-padding: 18;
                                       -fx-effect: dropshadow(
                                           gaussian,
                                           rgba(0,0,0,0.07),
                                           8,0,0,2
                                       );">

                            <Label
                                    fx:id="totalExpensesTitleLabel"
                                    text="Total Expenses"
                                    style="-fx-font-size: 13px;
                                           -fx-text-fill: #6B7280;"/>

                            <Label
                                    fx:id="totalExpensesValueLabel"
                                    text="0.00 EGP"
                                    style="-fx-font-size: 22px;
                                           -fx-font-weight: bold;
                                           -fx-text-fill: #DC2626;"/>

                            <Label
                                    fx:id="transactionsLabel"
                                    text="0 transactions"
                                    style="-fx-font-size: 11px;
                                           -fx-text-fill: #6B7280;"/>

                        </VBox>


                        <!-- ================= NET PROFIT ================= -->

                        <VBox
                                spacing="8"
                                HBox.hgrow="ALWAYS"
                                prefWidth="210"
                                style="-fx-background-color: white;
                                       -fx-background-radius: 10;
                                       -fx-padding: 18;
                                       -fx-effect: dropshadow(
                                           gaussian,
                                           rgba(0,0,0,0.07),
                                           8,0,0,2
                                       );">

                            <Label
                                    fx:id="netProfitTitleLabel"
                                    text="Net Profit"
                                    style="-fx-font-size: 13px;
                                           -fx-text-fill: #6B7280;"/>

                            <Label
                                    fx:id="netProfitValueLabel"
                                    text="0.00 EGP"
                                    style="-fx-font-size: 22px;
                                           -fx-font-weight: bold;
                                           -fx-text-fill: #2563EB;"/>

                            <Label
                                    fx:id="revenueMinusExpensesLabel"
                                    text="Revenue - Expenses"
                                    style="-fx-font-size: 11px;
                                           -fx-text-fill: #6B7280;"/>

                        </VBox>


                        <!-- ================= ACTIVE MEMBERS ================= -->

                        <VBox
                                spacing="8"
                                HBox.hgrow="ALWAYS"
                                prefWidth="210"
                                style="-fx-background-color: white;
                                       -fx-background-radius: 10;
                                       -fx-padding: 18;
                                       -fx-effect: dropshadow(
                                           gaussian,
                                           rgba(0,0,0,0.07),
                                           8,0,0,2
                                       );">

                            <Label
                                    fx:id="activeMembersTitleLabel"
                                    text="Active Members"
                                    style="-fx-font-size: 13px;
                                           -fx-text-fill: #6B7280;"/>

                            <Label
                                    fx:id="activeMembersValueLabel"
                                    text="0"
                                    style="-fx-font-size: 22px;
                                           -fx-font-weight: bold;
                                           -fx-text-fill: #F97316;"/>

                            <Label
                                    fx:id="newMembersLabel"
                                    text="+0 new members"
                                    style="-fx-font-size: 11px;
                                           -fx-text-fill: #6B7280;"/>

                        </VBox>

                    </HBox>


                    <!-- ================================================= -->
                    <!-- CHART + SUMMARY                                   -->
                    <!-- ================================================= -->

                    <HBox
                            spacing="15"
                            minHeight="340"
                            prefHeight="380">

                        <!-- ================= CHART ================= -->

                        <VBox
                                spacing="10"
                                HBox.hgrow="ALWAYS"
                                style="-fx-background-color: white;
                                       -fx-background-radius: 10;
                                       -fx-padding: 15;
                                       -fx-effect: dropshadow(
                                           gaussian,
                                           rgba(0,0,0,0.05),
                                           8,0,0,2
                                       );">

                            <Label
                                    fx:id="revenueExpensesTitleLabel"
                                    text="Revenue &amp; Expenses"
                                    style="-fx-font-size: 17px;
                                           -fx-font-weight: bold;
                                           -fx-text-fill: #1F2937;"/>

                            <BarChart
                                    fx:id="financialChart"
                                    title="Monthly Financial Performance"
                                    animated="false"
                                    legendVisible="true"
                                    categoryGap="20"
                                    barGap="4"
                                    VBox.vgrow="ALWAYS">

                                <xAxis>

                                    <CategoryAxis
                                            fx:id="monthAxis"
                                            label="Month"
                                            side="BOTTOM"/>

                                </xAxis>

                                <yAxis>

                                    <NumberAxis
                                            fx:id="amountAxis"
                                            label="Amount (EGP)"
                                            side="LEFT"
                                            forceZeroInRange="true"/>

                                </yAxis>

                            </BarChart>

                        </VBox>


                        <!-- ================= SUMMARY ================= -->

                        <VBox
                                spacing="15"
                                prefWidth="285"
                                minWidth="260"
                                style="-fx-background-color: white;
                                       -fx-background-radius: 10;
                                       -fx-padding: 20;
                                       -fx-effect: dropshadow(
                                           gaussian,
                                           rgba(0,0,0,0.05),
                                           8,0,0,2
                                       );">

                            <Label
                                    fx:id="summaryTitleLabel"
                                    text="Report Summary"
                                    style="-fx-font-size: 17px;
                                           -fx-font-weight: bold;
                                           -fx-text-fill: #1F2937;"/>


                            <!-- MEMBERSHIP REVENUE -->

                            <VBox spacing="5">

                                <Label
                                        fx:id="membershipRevenueLabel"
                                        text="Membership Revenue"
                                        style="-fx-text-fill: #6B7280;"/>

                                <Label
                                        fx:id="membershipRevenueValueLabel"
                                        text="0.00 EGP"
                                        style="-fx-font-size: 17px;
                                               -fx-font-weight: bold;
                                               -fx-text-fill: #1F2937;"/>

                            </VBox>


                            <!-- OTHER REVENUE -->

                            <VBox spacing="5">

                                <Label
                                        fx:id="otherRevenueLabel"
                                        text="Other Revenue"
                                        style="-fx-text-fill: #6B7280;"/>

                                <Label
                                        fx:id="otherRevenueValueLabel"
                                        text="0.00 EGP"
                                        style="-fx-font-size: 17px;
                                               -fx-font-weight: bold;
                                               -fx-text-fill: #1F2937;"/>

                            </VBox>


                            <!-- OPERATING EXPENSES -->

                            <VBox spacing="5">

                                <Label
                                        fx:id="operatingExpensesLabel"
                                        text="Operating Expenses"
                                        style="-fx-text-fill: #6B7280;"/>

                                <Label
                                        fx:id="operatingExpensesValueLabel"
                                        text="0.00 EGP"
                                        style="-fx-font-size: 17px;
                                               -fx-font-weight: bold;
                                               -fx-text-fill: #DC2626;"/>

                            </VBox>


                            <Region VBox.vgrow="ALWAYS"/>


                            <!-- PROFIT MARGIN -->

                            <VBox
                                    spacing="5"
                                    style="-fx-background-color: #F9FAFB;
                                           -fx-background-radius: 8;
                                           -fx-padding: 12;">

                                <Label
                                        fx:id="profitMarginLabel"
                                        text="Profit Margin"
                                        style="-fx-text-fill: #6B7280;"/>

                                <Label
                                        fx:id="profitMarginValueLabel"
                                        text="0.00%"
                                        style="-fx-font-size: 22px;
                                               -fx-font-weight: bold;
                                               -fx-text-fill: #16A34A;"/>

                            </VBox>

                        </VBox>

                    </HBox>


                    <!-- ================================================= -->
                    <!-- FINANCIAL ACTIVITY                                -->
                    <!-- ================================================= -->

                    <VBox
                            spacing="12"
                            style="-fx-background-color: white;
                                   -fx-background-radius: 10;
                                   -fx-padding: 15;
                                   -fx-effect: dropshadow(
                                       gaussian,
                                       rgba(0,0,0,0.05),
                                       8,0,0,2
                                   );">

                        <HBox alignment="CENTER_LEFT">

                            <Label
                                    fx:id="recentActivityTitleLabel"
                                    text="Recent Financial Activity"
                                    style="-fx-font-size: 17px;
                                           -fx-font-weight: bold;
                                           -fx-text-fill: #1F2937;"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Button
                                    fx:id="viewAllButton"
                                    text="View All"
                                    style="-fx-background-color: transparent;
                                           -fx-text-fill: #F97316;
                                           -fx-font-weight: bold;
                                           -fx-cursor: hand;"/>

                        </HBox>


                        <TableView
                                fx:id="financialActivityTable"
                                prefHeight="230"
                                minHeight="200"
                                >

                            <columns>

                                <TableColumn
                                        fx:id="dateColumn"
                                        text="Date"
                                        prefWidth="145"/>

                                <TableColumn
                                        fx:id="descriptionColumn"
                                        text="Description"
                                        prefWidth="230"/>

                                <TableColumn
                                        fx:id="typeColumn"
                                        text="Type"
                                        prefWidth="110"/>

                                <TableColumn
                                        fx:id="amountColumn"
                                        text="Amount"
                                        prefWidth="135"/>

                                <TableColumn
                                        fx:id="paymentMethodColumn"
                                        text="Payment Method"
                                        prefWidth="145"/>

                                <TableColumn
                                        fx:id="statusColumn"
                                        text="Status"
                                        prefWidth="110"/>

                            </columns>

                        </TableView>

                    </VBox>

                </VBox>

            </content>

        </ScrollPane>

    </children>

</AnchorPane>