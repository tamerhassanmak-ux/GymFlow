<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>
<?import com.mycompany.lazar_app.ui.ResponsiveRow?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" prefHeight="700.0" prefWidth="950.0" fx:controller="com.mycompany.lazar_app.controller.ReportsController" styleClass="app-page" minWidth="0" minHeight="0">
    <top>
        <ResponsiveRow alignment="CENTER_LEFT" spacing="15">
            <VBox spacing="5">
                <Label fx:id="titleLabel" text="Reports &amp; Analytics" style="-fx-font-size: 26px;                                            -fx-font-weight: bold;                                            " styleClass="ui-text" />
                <Label fx:id="subtitleLabel" text="Monitor gym financial and membership performance" style="-fx-font-size: 13px;                                            " styleClass="ui-muted" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
        </ResponsiveRow>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" style="-fx-background-color: transparent;                        -fx-background: #F5F7FA;">
            <content>
                <VBox spacing="20" styleClass="app-page">
                    <padding>
                        <Insets top="25" right="30" bottom="25" left="30" />
                    </padding>
                    <ResponsiveRow alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: white;                                    -fx-background-radius: 10;                                    -fx-padding: 15;">
                        <Label fx:id="reportLabel" text="Report:" style="-fx-font-weight: bold;                                        " styleClass="ui-text" />
                        <ComboBox fx:id="reportTypeComboBox" promptText="Report Type" prefWidth="170" />
                        <Label fx:id="fromLabel" text="From:" styleClass="ui-muted" />
                        <DatePicker fx:id="fromDatePicker" prefWidth="145" />
                        <Label fx:id="toLabel" text="To:" styleClass="ui-muted" />
                        <DatePicker fx:id="toDatePicker" prefWidth="145" />
                        <Region HBox.hgrow="ALWAYS" />
                    </ResponsiveRow>
                    <ResponsiveRow spacing="15">
                        <VBox spacing="8" HBox.hgrow="ALWAYS" prefWidth="210" style="-fx-padding: 18;" styleClass="surface-card">
                            <Label fx:id="totalRevenueTitleLabel" text="Total Revenue" style="-fx-font-size: 13px;                                            " styleClass="ui-muted" />
                            <Label fx:id="totalRevenueValueLabel" text="0.00" style="-fx-font-size: 22px;                                            -fx-font-weight: bold;                                            -fx-text-fill: #16A34A;" />
                            <Label fx:id="revenueChangeLabel" text="Realized revenue for selected period" wrapText="true" style="-fx-font-size: 11px;                                            -fx-text-fill: #16A34A;" />
                        </VBox>
                        <VBox spacing="8" HBox.hgrow="ALWAYS" prefWidth="210" style="-fx-padding: 18;" styleClass="surface-card">
                            <Label fx:id="totalExpensesTitleLabel" text="Total Expenses" style="-fx-font-size: 13px;                                            " styleClass="ui-muted" />
                            <Label fx:id="totalExpensesValueLabel" text="0.00" style="-fx-font-size: 22px;                                            -fx-font-weight: bold;                                            -fx-text-fill: #DC2626;" />
                            <Label fx:id="transactionsLabel" text="0 transactions" style="-fx-font-size: 11px;                                            " styleClass="ui-muted" />
                        </VBox>
                        <VBox spacing="8" HBox.hgrow="ALWAYS" prefWidth="210" style="-fx-padding: 18;" styleClass="surface-card">
                            <Label fx:id="netProfitTitleLabel" text="Net Profit" style="-fx-font-size: 13px;                                            " styleClass="ui-muted" />
                            <Label fx:id="netProfitValueLabel" text="0.00" style="-fx-font-size: 22px;                                            -fx-font-weight: bold;                                            -fx-text-fill: #2563EB;" />
                            <Label fx:id="revenueMinusExpensesLabel" text="Revenue - Expenses" style="-fx-font-size: 11px;                                            " styleClass="ui-muted" />
                        </VBox>
                        <VBox spacing="8" HBox.hgrow="ALWAYS" prefWidth="210" style="-fx-padding: 18;" styleClass="surface-card">
                            <Label fx:id="activeMembersTitleLabel" text="Active Members" style="-fx-font-size: 13px;                                            " styleClass="ui-muted" />
                            <Label fx:id="activeMembersValueLabel" text="0" style="-fx-font-size: 22px;                                            -fx-font-weight: bold;                                            -fx-text-fill: #F97316;" />
                            <Label fx:id="newMembersLabel" text="+0 new members" style="-fx-font-size: 11px;                                            " styleClass="ui-muted" />
                        </VBox>
                    </ResponsiveRow>
                    <ResponsiveRow spacing="15" minHeight="340" prefHeight="380">
                        <VBox spacing="10" HBox.hgrow="ALWAYS" style="-fx-padding: 15;" styleClass="surface-card">
                            <Label fx:id="revenueExpensesTitleLabel" text="Revenue &amp; Expenses" style="-fx-font-size: 17px;                                            -fx-font-weight: bold;                                            " styleClass="ui-text" />
                            <BarChart fx:id="financialChart" title="Monthly Financial Performance" animated="false" legendVisible="true" categoryGap="20" barGap="4" VBox.vgrow="ALWAYS">
                                <xAxis>
                                    <CategoryAxis fx:id="monthAxis" label="Month" side="BOTTOM" />
                                </xAxis>
                                <yAxis>
                                    <NumberAxis fx:id="amountAxis" label="" side="LEFT" forceZeroInRange="true" />
                                </yAxis>
                            </BarChart>
                        </VBox>
                        <VBox spacing="15" prefWidth="285" minWidth="260" style="-fx-padding: 20;" styleClass="surface-card">
                            <Label fx:id="summaryTitleLabel" text="Report Summary" style="-fx-font-size: 17px;                                            -fx-font-weight: bold;                                            " styleClass="ui-text" />
                            <VBox spacing="5">
                                <Label fx:id="membershipRevenueLabel" text="Membership Revenue" styleClass="ui-muted" />
                                <Label fx:id="membershipRevenueValueLabel" text="0.00" style="-fx-font-size: 17px;                                                -fx-font-weight: bold;                                                " styleClass="ui-text" />
                            </VBox>
                            <VBox spacing="5">
                                <Label fx:id="otherRevenueLabel" text="Other Revenue" styleClass="ui-muted" />
                                <Label fx:id="otherRevenueValueLabel" text="0.00" style="-fx-font-size: 17px;                                                -fx-font-weight: bold;                                                " styleClass="ui-text" />
                            </VBox>
                            <VBox spacing="5">
                                <Label fx:id="operatingExpensesLabel" text="Operating Expenses" styleClass="ui-muted" />
                                <Label fx:id="operatingExpensesValueLabel" text="0.00" style="-fx-font-size: 17px;                                                -fx-font-weight: bold;                                                -fx-text-fill: #DC2626;" />
                            </VBox>
                            <Region VBox.vgrow="ALWAYS" />
                            <VBox spacing="5" style="-fx-background-color: #F9FAFB;                                            -fx-background-radius: 8;                                            -fx-padding: 12;">
                                <Label fx:id="profitMarginLabel" text="Profit Margin" styleClass="ui-muted" />
                                <Label fx:id="profitMarginValueLabel" text="0.00%" style="-fx-font-size: 22px;                                                -fx-font-weight: bold;                                                -fx-text-fill: #16A34A;" />
                            </VBox>
                        </VBox>
                    </ResponsiveRow>
                    <VBox spacing="12" style="-fx-padding: 15;" styleClass="surface-card">
                        <ResponsiveRow alignment="CENTER_LEFT">
                            <Label fx:id="recentActivityTitleLabel" text="Recent Financial Activity" style="-fx-font-size: 17px;                                            -fx-font-weight: bold;                                            " styleClass="ui-text" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button fx:id="viewAllButton" text="View All" style="-fx-background-color: transparent;                                            -fx-text-fill: #F97316;                                            -fx-font-weight: bold;                                            -fx-cursor: hand;" />
                        </ResponsiveRow>
                        <TableView fx:id="financialActivityTable" prefHeight="230" minHeight="200">
                            <columns>
                                <TableColumn fx:id="dateColumn" text="Date" prefWidth="145" />
                                <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="230" />
                                <TableColumn fx:id="typeColumn" text="Type" prefWidth="110" />
                                <TableColumn fx:id="amountColumn" text="Amount" prefWidth="135" />
                                <TableColumn fx:id="paymentMethodColumn" text="Payment Method" prefWidth="145" />
                                <TableColumn fx:id="statusColumn" text="Status" prefWidth="110" />
                            </columns>
                        </TableView>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <ResponsiveRow spacing="12" alignment="CENTER_RIGHT" styleClass="persistent-actions">
            <Button fx:id="generateButton" text="Generate" style="-fx-padding: 8 20; -fx-cursor: hand;" styleClass="neutral-button" />
            <Button fx:id="exportButton" text="Export Report" style="-fx-padding: 10 20; -fx-cursor: hand;" styleClass="primary-button" />
        </ResponsiveRow>
    </bottom>
</BorderPane>
