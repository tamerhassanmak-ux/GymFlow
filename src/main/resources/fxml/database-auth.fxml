<?xml version="1.0" encoding="UTF-8"?>
<?import com.mycompany.lazar_app.ui.ResponsiveRow?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.lazar_app.controller.DatabaseAuthController" prefWidth="460" style="-fx-background-color: white;" styleClass=" responsive-form" minWidth="0" minHeight="0">
    <top>
        <Label text="%database.auth.title" style="-fx-font-size: 22px; -fx-font-weight: bold; " styleClass="ui-text form-header" />
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" minWidth="0" minHeight="0" styleClass="responsive-content">
            <content>
                <VBox spacing="18" style="-fx-background-color: white;">
                    <padding>
                        <Insets top="28" right="30" bottom="28" left="30" />
                    </padding>
                    <Label text="%database.auth.description" wrapText="true" styleClass="ui-muted" />
                    <PasswordField fx:id="passwordField" promptText="%database.auth.password" prefHeight="42" />
                    <Label fx:id="messageLabel" wrapText="true" style="-fx-text-fill: #DC2626;" />
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <ResponsiveRow spacing="10" styleClass=" persistent-actions">
            <Region HBox.hgrow="ALWAYS" />
            <Button text="%common.cancel" onAction="#handleCancel" />
            <Button text="%database.auth.verify" onAction="#handleVerify" defaultButton="true" styleClass="primary-button" />
        </ResponsiveRow>
    </bottom>
</BorderPane>
