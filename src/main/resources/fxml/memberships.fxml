<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox
        prefHeight="650.0"
        prefWidth="950.0"
        spacing="22.0"
        styleClass="members-page"
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.mycompany.lazar_app.controller.MembershipsController">

    <!-- =========================================
         PAGE PADDING
    ========================================== -->

    <padding>
        <Insets
                top="30.0"
                right="30.0"
                bottom="30.0"
                left="30.0"/>
    </padding>


    <children>

        <!-- =========================================
             HEADER
        ========================================== -->

        <HBox
                alignment="CENTER_LEFT"
                spacing="15.0">

            <children>

                <VBox spacing="5.0">

                    <children>

                        <Label
                                text="%memberships.title"
                                styleClass="page-title"/>

                        <Label
                                text="%memberships.subtitle"
                                styleClass="page-subtitle"/>

                    </children>

                </VBox>


                <Region HBox.hgrow="ALWAYS"/>


                <Button
                        fx:id="newMembershipButton"
                        text="%memberships.newMembership"
                        mnemonicParsing="false"
                        onAction="#openNewMembership"
                        styleClass="primary-button"/>

            </children>

        </HBox>


        <!-- =========================================
             STATISTICS
        ========================================== -->

        <HBox spacing="15.0">

            <children>

                <!-- =================================
                     ACTIVE MEMBERSHIPS
                ================================== -->

                <VBox
                        prefHeight="105.0"
                        spacing="8.0"
                        styleClass="dashboard-card"
                        HBox.hgrow="ALWAYS">

                    <children>

                        <Label
                                text="%memberships.stats.active"
                                styleClass="card-title"/>


                        <Label
                                fx:id="activeMembershipsLabel"
                                text="0"
                                styleClass="card-value"/>


                        <Label
                                text="%memberships.stats.currentlyActive"
                                styleClass="stat-description"/>

                    </children>

                </VBox>


                <!-- =================================
                     EXPIRING SOON
                ================================== -->

                <VBox
                        prefHeight="105.0"
                        spacing="8.0"
                        styleClass="dashboard-card"
                        HBox.hgrow="ALWAYS">

                    <children>

                        <Label
                                text="%memberships.stats.expiring"
                                styleClass="card-title"/>


                        <Label
                                fx:id="expiringMembershipsLabel"
                                text="0"
                                styleClass="card-value"/>


                        <Label
                                text="%memberships.stats.next7Days"
                                styleClass="stat-description"/>

                    </children>

                </VBox>


                <!-- =================================
                     EXPIRED
                ================================== -->

                <VBox
                        prefHeight="105.0"
                        spacing="8.0"
                        styleClass="dashboard-card"
                        HBox.hgrow="ALWAYS">

                    <children>

                        <Label
                                text="%memberships.stats.expired"
                                styleClass="card-title"/>


                        <Label
                                fx:id="expiredMembershipsLabel"
                                text="0"
                                styleClass="card-value"/>


                        <Label
                                text="%memberships.stats.needRenewal"
                                styleClass="stat-description"/>

                    </children>

                </VBox>


                <!-- =================================
                     MONTHLY REVENUE
                ================================== -->

                <VBox
                        prefHeight="105.0"
                        spacing="8.0"
                        styleClass="dashboard-card"
                        HBox.hgrow="ALWAYS">

                    <children>

                        <Label
                                text="%memberships.stats.monthlyRevenue"
                                styleClass="card-title"/>


                        <Label
                                fx:id="monthlyRevenueLabel"
                                text="0.00 EGP"
                                styleClass="card-value"/>


                        <Label
                                text="%memberships.stats.membershipRevenue"
                                styleClass="stat-description"/>

                    </children>

                </VBox>

            </children>

        </HBox>


        <!-- =========================================
             SEARCH AND FILTERS
        ========================================== -->

        <HBox
                alignment="CENTER_LEFT"
                spacing="12.0"
                styleClass="members-toolbar">

            <children>

                <!-- SEARCH -->

                <TextField
                        fx:id="searchField"
                        promptText="%memberships.search"
                        prefHeight="42.0"
                        prefWidth="330.0"/>


                <!-- PLAN FILTER -->

                <ComboBox
                        fx:id="planFilter"
                        promptText="%memberships.filters.allPlans"
                        prefHeight="42.0"
                        prefWidth="150.0"/>


                <!-- STATUS FILTER -->

                <ComboBox
                        fx:id="statusFilter"
                        promptText="%memberships.filters.allStatus"
                        prefHeight="42.0"
                        prefWidth="150.0"/>


                <Region HBox.hgrow="ALWAYS"/>


                <!-- DYNAMIC COUNT -->

                <Label
                        fx:id="membershipsCountLabel"
                        text="0"
                        styleClass="members-count"/>

            </children>

        </HBox>


        <!-- =========================================
             MEMBERSHIPS TABLE
        ========================================== -->

        <VBox
                spacing="0.0"
                styleClass="table-card"
                VBox.vgrow="ALWAYS">

            <children>

                <TableView
                        fx:id="membershipsTable"
                        prefHeight="300.0"
                        VBox.vgrow="ALWAYS">

                    <columns>

                        <!-- ID -->

                        <TableColumn
                                fx:id="idColumn"
                                text="%memberships.table.id"
                                prefWidth="60.0"/>


                        <!-- MEMBER -->

                        <TableColumn
                                fx:id="memberColumn"
                                text="%memberships.table.member"
                                prefWidth="180.0"/>


                        <!-- PLAN -->

                        <TableColumn
                                fx:id="planColumn"
                                text="%memberships.table.plan"
                                prefWidth="130.0"/>


                        <!-- START DATE -->

                        <TableColumn
                                fx:id="startDateColumn"
                                text="%memberships.table.startDate"
                                prefWidth="120.0"/>


                        <!-- END DATE -->

                        <TableColumn
                                fx:id="endDateColumn"
                                text="%memberships.table.endDate"
                                prefWidth="120.0"/>


                        <!-- AMOUNT -->

                        <TableColumn
                                fx:id="amountColumn"
                                text="%memberships.table.amount"
                                prefWidth="110.0"/>


                        <!-- STATUS -->

                        <TableColumn
                                fx:id="statusColumn"
                                text="%memberships.table.status"
                                prefWidth="100.0"/>

                    </columns>

                </TableView>

            </children>

        </VBox>


        <!-- =========================================
             FOOTER
        ========================================== -->

        <HBox
                alignment="CENTER_LEFT"
                spacing="10.0">

            <children>

                <Label
                        text="%memberships.footer"
                        styleClass="table-footer-text"/>


                <Region HBox.hgrow="ALWAYS"/>


                <Label
                        text="%app.title"
                        styleClass="table-footer-text"/>

            </children>

        </HBox>

    </children>

</VBox>