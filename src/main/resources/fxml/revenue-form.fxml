<?xml version="1.0" encoding="UTF-8"?>
<?import com.mycompany.lazar_app.ui.ResponsiveRow?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.lazar_app.controller.RevenueFormController" style="-fx-background:#F5F7FB;-fx-background-color:#F5F7FB;" styleClass=" responsive-form" minWidth="0" minHeight="0">
    <top>
        <VBox spacing="7" maxWidth="1000" styleClass=" form-header">
            <Label fx:id="titleLabel" text="New Revenue" style="-fx-font-size:30px;-fx-font-weight:bold;" styleClass="ui-text" />
            <Label fx:id="subtitleLabel" text="Record the revenue and optionally attach its source document" style="-fx-font-size:14px;" styleClass="ui-muted" />
        </VBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background:#F5F7FB;-fx-background-color:#F5F7FB;">
            <content>
                <VBox spacing="20" alignment="TOP_CENTER" styleClass="app-page">
                    <padding>
                        <Insets top="34" right="42" bottom="40" left="42" />
                    </padding>
                    <children>
                        <VBox spacing="20" maxWidth="1000" style="-fx-padding: 28;" styleClass="surface-card">
                            <VBox spacing="7">
                                <Label fx:id="nameLabel" text="Revenue Name" style="-fx-font-weight:bold;" styleClass="ui-text" />
                                <TextField fx:id="nameField" promptText="Example: Beverage sales" minHeight="44" />
                            </VBox>
                            <ResponsiveRow spacing="18">
                                <VBox spacing="7" HBox.hgrow="ALWAYS">
                                    <Label fx:id="typeLabel" text="Revenue Type" style="-fx-font-weight:bold;" styleClass="ui-text" />
                                    <ComboBox fx:id="typeComboBox" editable="true" maxWidth="Infinity" minHeight="44" promptText="Select or type a new revenue type" />
                                </VBox>
                                <VBox spacing="7" HBox.hgrow="ALWAYS">
                                    <Label fx:id="amountLabel" text="Amount" style="-fx-font-weight:bold;" styleClass="ui-text" />
                                    <TextField fx:id="amountField" promptText="0.00" minHeight="44" />
                                </VBox>
                            </ResponsiveRow>
                            <VBox spacing="7">
                                <Label fx:id="dateLabel" text="Revenue Date" style="-fx-font-weight:bold;" styleClass="ui-text" />
                                <DatePicker fx:id="revenueDatePicker" maxWidth="Infinity" minHeight="44" />
                            </VBox>
                            <Separator />
                            <VBox spacing="10" style="-fx-background-color:#F8FAFC;-fx-background-radius:10;-fx-padding:18;">
                                <Label fx:id="attachmentTitleLabel" text="Income Source Document" style="-fx-font-size:15px;-fx-font-weight:bold;" styleClass="ui-text" />
                                <Label fx:id="attachmentNameLabel" text="No attachment selected" wrapText="true" styleClass="ui-muted" />
                                <ResponsiveRow spacing="10">
                                    <Button fx:id="chooseAttachmentButton" text="Choose File" onAction="#chooseAttachment" minHeight="38" style="-fx-background-color:#2563EB;-fx-text-fill:white;-fx-font-weight:bold;-fx-background-radius:8;-fx-padding:8 18;-fx-cursor:hand;" />
                                    <Button fx:id="removeAttachmentButton" text="Remove Attachment" onAction="#removeAttachment" minHeight="38" style="-fx-background-color:#E5E7EB;-fx-text-fill:#374151;-fx-font-weight:bold;-fx-background-radius:8;-fx-padding:8 18;-fx-cursor:hand;" />
                                </ResponsiveRow>
                            </VBox>
                            <VBox spacing="7">
                                <Label fx:id="notesLabel" text="Notes" style="-fx-font-weight:bold;" styleClass="ui-text" />
                                <TextArea fx:id="notesArea" promptText="Optional notes..." prefRowCount="5" wrapText="true" />
                            </VBox>
                            <Separator />
                        </VBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <ResponsiveRow spacing="12" alignment="CENTER_RIGHT" styleClass=" persistent-actions">
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="cancelButton" text="Cancel" onAction="#cancel" minWidth="130" minHeight="44" style="-fx-background-color:#E5E7EB;-fx-text-fill:#374151;-fx-font-weight:bold;-fx-background-radius:9;-fx-cursor:hand;" />
            <Button fx:id="saveButton" text="Save Revenue" onAction="#saveRevenue" minWidth="170" minHeight="44" style="-fx-cursor: hand;" styleClass="primary-button" />
        </ResponsiveRow>
    </bottom>
</BorderPane>
