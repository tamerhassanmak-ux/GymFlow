<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane
        fitToWidth="true"
        hbarPolicy="NEVER"
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.mycompany.lazar_app.controller.RevenueFormController"
        style="-fx-background:#F5F7FB;-fx-background-color:#F5F7FB;">

    <content>
        <VBox spacing="20" alignment="TOP_CENTER"
              style="-fx-background-color:#F5F7FB;">

            <padding>
                <Insets top="34" right="42" bottom="40" left="42"/>
            </padding>

            <children>

                <VBox spacing="7" maxWidth="1000">
                    <Label fx:id="titleLabel"
                           text="New Revenue"
                           style="-fx-font-size:30px;-fx-font-weight:bold;-fx-text-fill:#111827;"/>
                    <Label fx:id="subtitleLabel"
                           text="Record the revenue and optionally attach its source document"
                           style="-fx-font-size:14px;-fx-text-fill:#64748B;"/>
                </VBox>

                <VBox spacing="20" maxWidth="1000"
                      style="-fx-background-color:white;-fx-background-radius:14;-fx-padding:28;-fx-effect:dropshadow(gaussian,rgba(0,0,0,0.07),12,0,0,3);">

                    <VBox spacing="7">
                        <Label fx:id="nameLabel" text="Revenue Name"
                               style="-fx-font-weight:bold;-fx-text-fill:#374151;"/>
                        <TextField fx:id="nameField"
                                   promptText="Example: Beverage sales"
                                   minHeight="44"/>
                    </VBox>

                    <HBox spacing="18">
                        <VBox spacing="7" HBox.hgrow="ALWAYS">
                            <Label fx:id="typeLabel" text="Revenue Type"
                                   style="-fx-font-weight:bold;-fx-text-fill:#374151;"/>
                            <ComboBox fx:id="typeComboBox"
                                      editable="true"
                                      maxWidth="Infinity"
                                      minHeight="44"
                                      promptText="Select or type a new revenue type"/>
                        </VBox>

                        <VBox spacing="7" HBox.hgrow="ALWAYS">
                            <Label fx:id="amountLabel" text="Amount"
                                   style="-fx-font-weight:bold;-fx-text-fill:#374151;"/>
                            <TextField fx:id="amountField"
                                       promptText="0.00"
                                       minHeight="44"/>
                        </VBox>
                    </HBox>

                    <VBox spacing="7">
                        <Label fx:id="dateLabel" text="Revenue Date"
                               style="-fx-font-weight:bold;-fx-text-fill:#374151;"/>
                        <DatePicker fx:id="revenueDatePicker"
                                    maxWidth="Infinity"
                                    minHeight="44"/>
                    </VBox>

                    <Separator/>

                    <VBox spacing="10"
                          style="-fx-background-color:#F8FAFC;-fx-background-radius:10;-fx-padding:18;">
                        <Label fx:id="attachmentTitleLabel"
                               text="Income Source Document"
                               style="-fx-font-size:15px;-fx-font-weight:bold;-fx-text-fill:#111827;"/>

                        <Label fx:id="attachmentNameLabel"
                               text="No attachment selected"
                               wrapText="true"
                               style="-fx-text-fill:#64748B;"/>

                        <HBox spacing="10">
                            <Button fx:id="chooseAttachmentButton"
                                    text="Choose File"
                                    onAction="#chooseAttachment"
                                    minHeight="38"
                                    style="-fx-background-color:#2563EB;-fx-text-fill:white;-fx-font-weight:bold;-fx-background-radius:8;-fx-padding:8 18;-fx-cursor:hand;"/>

                            <Button fx:id="removeAttachmentButton"
                                    text="Remove Attachment"
                                    onAction="#removeAttachment"
                                    minHeight="38"
                                    style="-fx-background-color:#E5E7EB;-fx-text-fill:#374151;-fx-font-weight:bold;-fx-background-radius:8;-fx-padding:8 18;-fx-cursor:hand;"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="7">
                        <Label fx:id="notesLabel" text="Notes"
                               style="-fx-font-weight:bold;-fx-text-fill:#374151;"/>
                        <TextArea fx:id="notesArea"
                                  promptText="Optional notes..."
                                  prefRowCount="5"
                                  wrapText="true"/>
                    </VBox>

                    <Separator/>

                    <HBox spacing="12" alignment="CENTER_RIGHT">
                        <Region HBox.hgrow="ALWAYS"/>

                        <Button fx:id="cancelButton"
                                text="Cancel"
                                onAction="#cancel"
                                minWidth="130"
                                minHeight="44"
                                style="-fx-background-color:#E5E7EB;-fx-text-fill:#374151;-fx-font-weight:bold;-fx-background-radius:9;-fx-cursor:hand;"/>

                        <Button fx:id="saveButton"
                                text="Save Revenue"
                                onAction="#saveRevenue"
                                minWidth="170"
                                minHeight="44"
                                style="-fx-background-color:#F97316;-fx-text-fill:white;-fx-font-weight:bold;-fx-background-radius:9;-fx-cursor:hand;"/>
                    </HBox>

                </VBox>

            </children>
        </VBox>
    </content>
</ScrollPane>
