<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.mycompany.lazar_app.controller.AddPaymentController"
        prefWidth="600"
        spacing="20"
        style="-fx-background-color: #F5F7FA;">

    <padding>
        <Insets top="25" right="30" bottom="25" left="30"/>
    </padding>

    <VBox spacing="5">
        <Label text="%addPayment.title"
               style="-fx-font-size:24px;-fx-font-weight:bold;-fx-text-fill:#1F2937;"/>
        <Label text="%addPayment.subtitle"
               style="-fx-font-size:13px;-fx-text-fill:#6B7280;"/>
    </VBox>

    <GridPane hgap="15" vgap="15">

        <Label text="%addPayment.member"
               GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="memberComboBox"
                  promptText="%addPayment.selectMember"
                  prefWidth="350" prefHeight="38"
                  GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="%addPayment.membership"
               GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <ComboBox fx:id="membershipComboBox"
                  promptText="%addPayment.selectMembership"
                  prefWidth="350" prefHeight="38"
                  GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="%addPayment.amount"
               GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="amountField"
                   promptText="%addPayment.amountPlaceholder"
                   prefHeight="38"
                   GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="%addPayment.paymentMethod"
               GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <ComboBox fx:id="paymentMethodComboBox"
                  promptText="%addPayment.selectPaymentMethod"
                  prefWidth="350" prefHeight="38"
                  GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="%addPayment.status"
               GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <ComboBox fx:id="statusComboBox"
                  promptText="%addPayment.selectStatus"
                  prefWidth="350" prefHeight="38"
                  GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="%addPayment.date"
               GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <DatePicker fx:id="paymentDatePicker"
                    prefWidth="350" prefHeight="38"
                    GridPane.rowIndex="5" GridPane.columnIndex="1"/>

        <Label text="%addPayment.reference"
               GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <TextField fx:id="referenceField"
                   promptText="%addPayment.referencePlaceholder"
                   prefHeight="38"
                   GridPane.rowIndex="6" GridPane.columnIndex="1"/>

        <Label text="%common.notes"
               GridPane.rowIndex="7" GridPane.columnIndex="0"/>
        <TextArea fx:id="notesArea"
                  promptText="%addPayment.notesPlaceholder"
                  prefHeight="90"
                  wrapText="true"
                  GridPane.rowIndex="7" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="10">
        <Region HBox.hgrow="ALWAYS"/>

        <Button text="%common.cancel"
                mnemonicParsing="false"
                onAction="#cancel"
                prefHeight="40"
                style="-fx-background-color:white;-fx-text-fill:#374151;-fx-border-color:#D1D5DB;-fx-border-radius:7;-fx-background-radius:7;-fx-padding:0 20;-fx-cursor:hand;"/>

        <Button text="%addPayment.save"
                mnemonicParsing="false"
                onAction="#savePayment"
                prefHeight="40"
                style="-fx-background-color:#F97316;-fx-text-fill:white;-fx-font-weight:bold;-fx-background-radius:7;-fx-padding:0 22;-fx-cursor:hand;"/>
    </HBox>

</VBox>