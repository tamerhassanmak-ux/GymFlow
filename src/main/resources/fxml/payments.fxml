<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ScrollBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="paymentsPage" minHeight="0" minWidth="0" prefHeight="720" prefWidth="1100"
        xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.mycompany.lazar_app.controller.PaymentsController"
        styleClass="app-page,bounded-page">
    <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>
    <top>
        <ScrollPane fx:id="paymentsHeaderViewport" fitToWidth="true" fitToHeight="false"
                    minWidth="0" minHeight="0" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED"
                    styleClass="payments-header-scroll">
        <content>
        <VBox spacing="16" minWidth="0" minHeight="-Infinity">
            <padding><Insets bottom="16"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="15">
                <VBox spacing="5">
                    <Label
                            text="%payments.title"
                             styleClass="page-title"/>
                    <Label
                            text="%payments.subtitle"
                            style="-fx-font-size: 13px;" styleClass="ui-muted"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button
                        text="%payments.newPayment"
                        mnemonicParsing="false"
                        onAction="#openNewPayment"
                        style="-fx-padding: 10 20; -fx-cursor: hand;" styleClass="primary-button"/>
            </HBox>

            <HBox spacing="15" minWidth="0">
                <VBox spacing="8" minWidth="0" prefWidth="210" HBox.hgrow="ALWAYS"
                      style="-fx-padding: 18;" styleClass="surface-card">
                    <Label text="%payments.stats.total" style="-fx-font-size: 13px; " styleClass="ui-muted"/>
                    <Label wrapText="true" minWidth="0" fx:id="totalPaymentsLabel" text="0.00"
                           style="-fx-font-size: 23px;-fx-font-weight: bold;" styleClass="ui-text"/>
                </VBox>

                <VBox spacing="8" minWidth="0" prefWidth="210" HBox.hgrow="ALWAYS"
                      style="-fx-padding: 18;" styleClass="surface-card">
                    <Label text="%payments.stats.month" style="-fx-font-size: 13px; " styleClass="ui-muted"/>
                    <Label wrapText="true" minWidth="0" fx:id="monthPaymentsLabel" text="0.00"
                           style="-fx-font-size: 23px;-fx-font-weight: bold;-fx-text-fill: #F97316;"/>
                </VBox>

                <VBox spacing="8" minWidth="0" prefWidth="210" HBox.hgrow="ALWAYS"
                      style="-fx-padding: 18;" styleClass="surface-card">
                    <Label text="%payments.stats.paid" style="-fx-font-size: 13px; " styleClass="ui-muted"/>
                    <Label wrapText="true" minWidth="0" fx:id="paidPaymentsLabel" text="0.00"
                           style="-fx-font-size: 23px;-fx-font-weight: bold;-fx-text-fill: #16A34A;"/>
                </VBox>

                <VBox spacing="8" minWidth="0" prefWidth="210" HBox.hgrow="ALWAYS"
                      style="-fx-padding: 18;" styleClass="surface-card">
                    <Label text="%payments.stats.pending" style="-fx-font-size: 13px; " styleClass="ui-muted"/>
                    <Label wrapText="true" minWidth="0" fx:id="pendingPaymentsLabel" text="0.00"
                           style="-fx-font-size: 23px;-fx-font-weight: bold;-fx-text-fill: #DC2626;"/>
                </VBox>
            </HBox>

            <FlowPane alignment="CENTER_LEFT" hgap="10" vgap="10" minWidth="0">
                <TextField fx:id="searchField" promptText="%payments.search" prefHeight="40" prefWidth="280"/>
                <ComboBox fx:id="paymentMethodFilter" promptText="%payments.paymentMethod" prefHeight="40" prefWidth="160"/>
                <ComboBox fx:id="statusFilter" promptText="%payments.status" prefHeight="40" prefWidth="130"/>
                <Button text="%common.search" mnemonicParsing="false" onAction="#searchPayments" prefHeight="40"
                        style="-fx-padding: 0 20; -fx-cursor: hand;" styleClass="neutral-button"/>


                <Button text="%common.refresh" mnemonicParsing="false" onAction="#refreshPayments" prefHeight="40"
                        style="-fx-padding: 0 18; -fx-cursor: hand;" styleClass="secondary-button"/>
            </FlowPane>

        </VBox>
        </content>
        </ScrollPane>
    </top>
    <center>
            <VBox spacing="12" minWidth="0" minHeight="0" style="-fx-padding: 16;" styleClass="surface-card">

                <HBox alignment="CENTER_LEFT">
                    <Label text="%payments.history"
                           style="-fx-font-size: 17px;-fx-font-weight: bold;" styleClass="ui-text"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="transactionsCountLabel" text="0"
                           style="-fx-font-size: 12px;" styleClass="ui-muted"/>
                </HBox>

                <!-- Native TableView horizontal/vertical scrollbars.
                     The table stays viewport-sized, while the sum of column
                     minimum widths exceeds it and enables horizontal scroll. -->
                <TableView fx:id="paymentsTable" nodeOrientation="LEFT_TO_RIGHT"
                           minWidth="0.0" prefWidth="1100.0" maxWidth="Infinity"
                           minHeight="80.0" prefHeight="320.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="memberCodeColumn" text="%payments.table.memberCode" prefWidth="145" minWidth="125"/>
                        <TableColumn fx:id="memberColumn" text="%payments.table.member" prefWidth="210" minWidth="175"/>
                        <TableColumn fx:id="membershipColumn" text="%payments.table.membership" prefWidth="170" minWidth="140"/>
                        <TableColumn fx:id="amountColumn" text="%payments.table.amount" prefWidth="135" minWidth="115"/>
                        <TableColumn fx:id="subscriptionAmountColumn" text="Subscription" prefWidth="140" minWidth="120"/>
                        <TableColumn fx:id="paidAmountColumn" text="Total Paid" prefWidth="140" minWidth="120"/>
                        <TableColumn fx:id="remainingAmountColumn" text="Remaining" prefWidth="140" minWidth="120"/>
                        <TableColumn fx:id="paymentMethodColumn" text="%payments.table.paymentMethod" prefWidth="135" minWidth="115"/>
                        <TableColumn fx:id="dateColumn" text="%payments.table.date" prefWidth="165" minWidth="145"/>
                        <TableColumn fx:id="statusColumn" text="%payments.table.status" prefWidth="110" minWidth="95"/>
                        <TableColumn fx:id="idColumn" text="%payments.table.id" prefWidth="75" minWidth="65"/>
                        <TableColumn fx:id="actionsColumn" text="%payments.table.actions" prefWidth="320" minWidth="310"/>
                    </columns>
                </TableView>
            </VBox>
    </center>
    <bottom>
        <VBox fx:id="paymentsFooter" spacing="10" minWidth="0" minHeight="-Infinity">
            <BorderPane.margin><Insets top="12"/></BorderPane.margin>
            <HBox spacing="12" alignment="CENTER_LEFT" minWidth="0" minHeight="30">
                <Label text="%payments.table.horizontalScroll" styleClass="ui-muted"/>
                <ScrollBar fx:id="paymentsHorizontalScroll" orientation="HORIZONTAL"
                           nodeOrientation="LEFT_TO_RIGHT" minWidth="80" prefHeight="24" minHeight="24"
                           HBox.hgrow="ALWAYS" styleClass="payments-horizontal-scroll"/>
            </HBox>
            <HBox fx:id="paginationHost" minWidth="0" minHeight="-Infinity"/>
        </VBox>
    </bottom>
</BorderPane>
