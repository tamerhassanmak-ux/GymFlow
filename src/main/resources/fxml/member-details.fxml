<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        prefWidth="1180.0"
        prefHeight="760.0"
        minWidth="760.0"
        minHeight="560.0"
        maxWidth="Infinity"
        maxHeight="Infinity"
        styleClass="member-details-root"
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.mycompany.lazar_app.controller.MemberDetailsController">

    <!-- =====================================================
         HEADER
         ===================================================== -->

    <top>

        <VBox styleClass="member-details-header">

            <padding>
                <Insets top="24" right="32" bottom="24" left="32"/>
            </padding>

            <HBox spacing="22"
                  alignment="CENTER_LEFT">

                <!-- PHOTO -->

                <StackPane
                        minWidth="112"
                        prefWidth="112"
                        minHeight="112"
                        prefHeight="112"
                        styleClass="member-details-photo-container">

                    <ImageView
                            fx:id="memberImageView"
                            fitWidth="104"
                            fitHeight="104"
                            preserveRatio="true"
                            smooth="true"/>

                    <Label
                            fx:id="photoPlaceholderLabel"
                            text="👤"
                            styleClass="member-details-photo-placeholder"/>

                </StackPane>


                <!-- MEMBER MAIN INFO -->

                <VBox spacing="7"
                      HBox.hgrow="ALWAYS">

                    <Label
                            fx:id="memberNameLabel"
                            text="Member Name"
                            styleClass="member-details-name"/>

                    <Label
                            fx:id="memberCodeLabel"
                            text="LZR-000000"
                            styleClass="member-details-code"/>

                    <HBox spacing="10"
                          alignment="CENTER_LEFT">

                        <Label
                                fx:id="membershipBadgeLabel"
                                text="Monthly"
                                styleClass="member-membership-badge"/>

                        <Label
                                fx:id="statusBadgeLabel"
                                text="Active"
                                styleClass="member-status-badge"/>

                    </HBox>

                </VBox>


                <Region HBox.hgrow="ALWAYS"/>


                <!-- QR -->

                <VBox spacing="7"
                      alignment="CENTER"
                      styleClass="member-details-qr-panel">

                    <Label
                            text="MEMBER QR"
                            styleClass="member-details-small-title"/>

                    <StackPane
                            minWidth="120"
                            minHeight="120"
                            prefWidth="120"
                            prefHeight="120"
                            styleClass="member-details-qr-box">

                        <ImageView
                                fx:id="qrCodeImageView"
                                fitWidth="108"
                                fitHeight="108"
                                preserveRatio="true"
                                smooth="false"/>

                        <Label
                                fx:id="qrPlaceholderLabel"
                                text="QR"
                                styleClass="member-details-qr-placeholder"/>

                    </StackPane>

                </VBox>

            </HBox>

        </VBox>

    </top>


    <!-- =====================================================
         CONTENT
         ===================================================== -->

    <center>

        <ScrollPane
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                pannable="true"
                styleClass="member-details-scroll">

            <content>

                <VBox
                        spacing="22"
                        minWidth="700"
                        maxWidth="Infinity"
                        maxHeight="Infinity">

                    <padding>
                        <Insets top="24" right="30" bottom="30" left="30"/>
                    </padding>


                    <!-- =========================================
                         KPI CARDS
                         ========================================= -->

                    <FlowPane
                            hgap="14"
                            vgap="14"
                            prefWrapLength="1000">

                        <!-- STATUS -->

                        <VBox
                                spacing="7"
                                prefWidth="245"
                                minHeight="105"
                                styleClass="member-kpi-card">

                            <Label
                                    text="STATUS"
                                    styleClass="member-kpi-title"/>

                            <Label
                                    fx:id="kpiStatusLabel"
                                    text="-"
                                    styleClass="member-kpi-value"/>

                            <Label
                                    fx:id="kpiStatusDescriptionLabel"
                                    text="-"
                                    styleClass="member-kpi-description"/>

                        </VBox>


                        <!-- REMAINING DAYS -->

                        <VBox
                                spacing="7"
                                prefWidth="245"
                                minHeight="105"
                                styleClass="member-kpi-card">

                            <Label
                                    text="REMAINING"
                                    styleClass="member-kpi-title"/>

                            <HBox spacing="6"
                                  alignment="BASELINE_LEFT">

                                <Label
                                        fx:id="remainingDaysLabel"
                                        text="0"
                                        styleClass="member-kpi-value"/>

                                <Label
                                        fx:id="daysTextLabel"
                                        text="Days"
                                        styleClass="member-kpi-unit"/>

                            </HBox>

                            <Label
                                    fx:id="remainingDescriptionLabel"
                                    text="-"
                                    styleClass="member-kpi-description"/>

                        </VBox>


                        <!-- START DATE -->

                        <VBox
                                spacing="7"
                                prefWidth="245"
                                minHeight="105"
                                styleClass="member-kpi-card">

                            <Label
                                    text="START DATE"
                                    styleClass="member-kpi-title"/>

                            <Label
                                    fx:id="kpiStartDateLabel"
                                    text="-"
                                    styleClass="member-kpi-date"/>

                            <Label
                                    text="Membership start"
                                    styleClass="member-kpi-description"/>

                        </VBox>


                        <!-- END DATE -->

                        <VBox
                                spacing="7"
                                prefWidth="245"
                                minHeight="105"
                                styleClass="member-kpi-card">

                            <Label
                                    text="END DATE"
                                    styleClass="member-kpi-title"/>

                            <Label
                                    fx:id="kpiEndDateLabel"
                                    text="-"
                                    styleClass="member-kpi-date"/>

                            <Label
                                    fx:id="endDateDescriptionLabel"
                                    text="Membership expiry"
                                    styleClass="member-kpi-description"/>

                        </VBox>


                        <!-- TRAINING SESSIONS -->

                        <VBox
                                spacing="7"
                                prefWidth="245"
                                minHeight="125"
                                styleClass="member-kpi-card">

                            <Label
                                    text="TRAINING SESSIONS"
                                    styleClass="member-kpi-title"/>

                            <Label
                                    fx:id="sessionsUsedLabel"
                                    text="-"
                                    styleClass="member-kpi-value"/>

                            <Label
                                    fx:id="sessionsRemainingLabel"
                                    text="-"
                                    styleClass="member-kpi-description"/>

                            <ProgressBar
                                    fx:id="sessionsProgressBar"
                                    progress="0.0"
                                    prefWidth="210"
                                    maxWidth="Infinity"/>

                            <Label
                                    fx:id="sessionsDescriptionLabel"
                                    text="-"
                                    wrapText="true"
                                    styleClass="member-kpi-description"/>

                        </VBox>

                    </FlowPane>


                    <!-- =========================================
                         INFORMATION
                         ========================================= -->

                    <HBox
                            spacing="18"
                            fillHeight="true"
                            maxWidth="Infinity">

                        <!-- PERSONAL INFO -->

                        <VBox
                                spacing="18"
                                HBox.hgrow="ALWAYS"
                                styleClass="member-info-card">

                            <Label
                                    text="Personal Information"
                                    styleClass="member-info-title"/>

                            <Region
                                    prefHeight="1"
                                    styleClass="member-info-separator"/>

                            <GridPane
                                    hgap="20"
                                    vgap="18">

                                <Label
                                        text="Phone"
                                        GridPane.rowIndex="0"
                                        GridPane.columnIndex="0"
                                        styleClass="member-field-title"/>

                                <Label
                                        fx:id="phoneLabel"
                                        text="-"
                                        GridPane.rowIndex="0"
                                        GridPane.columnIndex="1"
                                        styleClass="member-field-value"/>


                                <Label
                                        text="WhatsApp"
                                        GridPane.rowIndex="1"
                                        GridPane.columnIndex="0"
                                        styleClass="member-field-title"/>

                                <Label
                                        fx:id="whatsappLabel"
                                        text="-"
                                        GridPane.rowIndex="1"
                                        GridPane.columnIndex="1"
                                        styleClass="member-field-value"/>


                                <Label
                                        text="Email"
                                        GridPane.rowIndex="2"
                                        GridPane.columnIndex="0"
                                        styleClass="member-field-title"/>

                                <Label
                                        fx:id="emailLabel"
                                        text="-"
                                        GridPane.rowIndex="2"
                                        GridPane.columnIndex="1"
                                        styleClass="member-field-value"/>


                                <Label
                                        text="Gender"
                                        GridPane.rowIndex="3"
                                        GridPane.columnIndex="0"
                                        styleClass="member-field-title"/>

                                <Label
                                        fx:id="genderLabel"
                                        text="-"
                                        GridPane.rowIndex="3"
                                        GridPane.columnIndex="1"
                                        styleClass="member-field-value"/>


                                <Label
                                        text="Birth Date"
                                        GridPane.rowIndex="4"
                                        GridPane.columnIndex="0"
                                        styleClass="member-field-title"/>

                                <Label
                                        fx:id="birthDateLabel"
                                        text="-"
                                        GridPane.rowIndex="4"
                                        GridPane.columnIndex="1"
                                        styleClass="member-field-value"/>

                            </GridPane>

                        </VBox>


                        <!-- MEMBERSHIP INFO -->

                        <VBox
                                spacing="18"
                                HBox.hgrow="ALWAYS"
                                styleClass="member-info-card">

                            <Label
                                    text="Membership Information"
                                    styleClass="member-info-title"/>

                            <Region
                                    prefHeight="1"
                                    styleClass="member-info-separator"/>

                            <GridPane
                                    hgap="20"
                                    vgap="18">

                                <Label
                                        text="Plan"
                                        GridPane.rowIndex="0"
                                        GridPane.columnIndex="0"
                                        styleClass="member-field-title"/>

                                <Label
                                        fx:id="membershipLabel"
                                        text="-"
                                        GridPane.rowIndex="0"
                                        GridPane.columnIndex="1"
                                        styleClass="member-field-value"/>


                                <Label
                                        text="Status"
                                        GridPane.rowIndex="1"
                                        GridPane.columnIndex="0"
                                        styleClass="member-field-title"/>

                                <Label
                                        fx:id="statusLabel"
                                        text="-"
                                        GridPane.rowIndex="1"
                                        GridPane.columnIndex="1"
                                        styleClass="member-field-value"/>


                                <Label
                                        text="Start Date"
                                        GridPane.rowIndex="2"
                                        GridPane.columnIndex="0"
                                        styleClass="member-field-title"/>

                                <Label
                                        fx:id="startDateLabel"
                                        text="-"
                                        GridPane.rowIndex="2"
                                        GridPane.columnIndex="1"
                                        styleClass="member-field-value"/>


                                <Label
                                        text="End Date"
                                        GridPane.rowIndex="3"
                                        GridPane.columnIndex="0"
                                        styleClass="member-field-title"/>

                                <Label
                                        fx:id="endDateLabel"
                                        text="-"
                                        GridPane.rowIndex="3"
                                        GridPane.columnIndex="1"
                                        styleClass="member-field-value"/>


                                <Label
                                        text="Remaining Days"
                                        GridPane.rowIndex="4"
                                        GridPane.columnIndex="0"
                                        styleClass="member-field-title"/>

                                <Label
                                        fx:id="membershipRemainingLabel"
                                        text="-"
                                        GridPane.rowIndex="4"
                                        GridPane.columnIndex="1"
                                        styleClass="member-field-value"/>

                            </GridPane>

                        </VBox>

                    </HBox>


                    <!-- =========================================
                         NOTES
                         ========================================= -->

                    <VBox
                            spacing="12"
                            styleClass="member-info-card">

                        <Label
                                text="Notes"
                                styleClass="member-info-title"/>

                        <Region
                                prefHeight="1"
                                styleClass="member-info-separator"/>

                        <Label
                                fx:id="notesLabel"
                                text="-"
                                wrapText="true"
                                minHeight="50"
                                styleClass="member-notes-value"/>

                    </VBox>

                </VBox>

            </content>

        </ScrollPane>

    </center>


    <!-- =====================================================
         FOOTER
         ===================================================== -->

    <bottom>

        <HBox
                spacing="12"
                alignment="CENTER_RIGHT"
                styleClass="member-details-footer">

            <padding>
                <Insets top="15" right="30" bottom="15" left="30"/>
            </padding>

            <Button
                    text="Edit Member"
                    onAction="#editMember"
                    styleClass="member-details-edit-button"/>

            <Button
                    text="Close"
                    onAction="#closeWindow"
                    styleClass="member-details-close-button"/>

        </HBox>

    </bottom>

</BorderPane>