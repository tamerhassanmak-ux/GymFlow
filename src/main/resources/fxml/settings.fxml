<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import com.mycompany.lazar_app.ui.ResponsiveRow?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" prefHeight="700.0" prefWidth="950.0" fx:controller="com.mycompany.lazar_app.controller.SettingsController" styleClass="app-page" minWidth="0" minHeight="0">
    <top>
        <ResponsiveRow alignment="CENTER_LEFT">
            <VBox spacing="5">
                <Label fx:id="titleLabel" text="Settings" style="-fx-font-size: 26px;                                    -fx-font-weight: bold;                                    " styleClass="ui-text" />
                <Label fx:id="subtitleLabel" text="Manage application and gym settings" style="-fx-font-size: 13px;                                    " styleClass="ui-muted" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
        </ResponsiveRow>
    </top>
    <bottom>
        <ResponsiveRow spacing="12" alignment="CENTER_RIGHT" styleClass="persistent-actions">
            <Button fx:id="saveChangesButton" text="Save Changes" style="-fx-padding: 10 22; -fx-cursor: hand;" styleClass="primary-button" />
        </ResponsiveRow>
    </bottom>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" pannable="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background: transparent;">
            <content>
                <ResponsiveRow spacing="20">
                    <VBox spacing="20" HBox.hgrow="ALWAYS">
                        <VBox spacing="15" style="-fx-padding: 20;" styleClass="surface-card">
                            <Label fx:id="generalTitleLabel" text="General Information" style="-fx-font-size: 17px;                                        -fx-font-weight: bold;                                        " styleClass="ui-text" />
                            <Separator />
                            <VBox spacing="6">
                                <Label fx:id="gymNameLabel" text="Gym Name" style="-fx-font-weight: bold;                                            " styleClass="ui-text" />
                                <TextField fx:id="gymNameField" text="Lazar Gym" promptText="Enter gym name" prefHeight="38" />
                            </VBox>
                            <ResponsiveRow spacing="15">
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label fx:id="phoneLabel" text="Phone" style="-fx-font-weight: bold;                                                " styleClass="ui-text" />
                                    <TextField fx:id="phoneField" promptText="+20 10 0000 0000" prefHeight="38" />
                                </VBox>
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label fx:id="emailLabel" text="Email" style="-fx-font-weight: bold;                                                " styleClass="ui-text" />
                                    <TextField fx:id="emailField" promptText="info@lazargym.com" prefHeight="38" />
                                </VBox>
                            </ResponsiveRow>
                            <VBox spacing="6">
                                <Label fx:id="addressLabel" text="Address" style="-fx-font-weight: bold;                                            " styleClass="ui-text" />
                                <TextField fx:id="addressField" promptText="Enter gym address" prefHeight="38" />
                            </VBox>
                        </VBox>
                        <VBox spacing="15" style="-fx-padding: 20;" styleClass="surface-card">
                            <Label fx:id="regionalTitleLabel" text="Regional Settings" style="-fx-font-size: 17px;                                        -fx-font-weight: bold;                                        " styleClass="ui-text" />
                            <Separator />
                            <ResponsiveRow spacing="15">
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label fx:id="languageLabel" text="Language" style="-fx-font-weight: bold;                                                " styleClass="ui-text" />
                                    <ComboBox fx:id="languageComboBox" promptText="English" prefHeight="38" maxWidth="Infinity" />
                                </VBox>
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label fx:id="currencyLabel" text="Currency" style="-fx-font-weight: bold;                                                " styleClass="ui-text" />
                                    <ComboBox fx:id="currencyComboBox" promptText="EGP" prefHeight="38" maxWidth="Infinity" />
                                </VBox>
                            </ResponsiveRow>
                            <ResponsiveRow spacing="15">
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label fx:id="dateFormatLabel" text="Date Format" style="-fx-font-weight: bold;                                                " styleClass="ui-text" />
                                    <ComboBox fx:id="dateFormatComboBox" promptText="DD/MM/YYYY" prefHeight="38" maxWidth="Infinity" />
                                </VBox>
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label fx:id="timeZoneLabel" text="Time Zone" style="-fx-font-weight: bold;                                                " styleClass="ui-text" />
                                    <ComboBox fx:id="timeZoneComboBox" promptText="Africa/Cairo" prefHeight="38" maxWidth="Infinity" />
                                </VBox>
                            </ResponsiveRow>
                        </VBox>
                        <VBox spacing="15" style="-fx-background-color: white;                                    -fx-background-radius: 10;                                    -fx-padding: 20;">
                            <Label fx:id="membershipSettingsTitleLabel" text="Membership Settings" style="-fx-font-size: 17px;                                        -fx-font-weight: bold;                                        " styleClass="ui-text" />
                            <Separator />
                            <ResponsiveRow spacing="15">
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label fx:id="defaultMembershipLabel" text="Default Membership" style="-fx-font-weight: bold;" />
                                    <ComboBox fx:id="defaultMembershipComboBox" promptText="Monthly" maxWidth="Infinity" />
                                </VBox>
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label fx:id="gracePeriodLabel" text="Grace Period" style="-fx-font-weight: bold;" />
                                    <TextField fx:id="gracePeriodField" promptText="Days" />
                                </VBox>
                            </ResponsiveRow>
                            <CheckBox fx:id="autoExpireCheckBox" text="Automatically mark expired memberships" />
                            <CheckBox fx:id="renewBeforeExpiryCheckBox" text="Allow membership renewal before expiry" selected="true" />
                        </VBox>
                    </VBox>
                    <VBox spacing="20" prefWidth="310">
                        <VBox spacing="15" style="-fx-padding: 20;" styleClass="surface-card">
                            <Label fx:id="notificationsTitleLabel" text="Notifications" style="-fx-font-size: 17px;                                        -fx-font-weight: bold;                                        " styleClass="ui-text" />
                            <Separator />
                            <CheckBox fx:id="expiryAlertsCheckBox" text="Membership expiry alerts" selected="true" />
                            <CheckBox fx:id="paymentRemindersCheckBox" text="Payment reminders" selected="true" />
                            <CheckBox fx:id="newMemberNotificationCheckBox" text="New member notification" />
                            <CheckBox fx:id="expenseNotificationsCheckBox" text="Expense notifications" />
                            <VBox spacing="6">
                                <Label fx:id="expiryWarningLabel" text="Expiry Warning" style="-fx-font-weight: bold;" />
                                <TextField fx:id="expiryWarningField" promptText="3 days before expiry" />
                            </VBox>
                        </VBox>
                        <VBox spacing="15" style="-fx-background-color: white;                                    -fx-background-radius: 10;                                    -fx-padding: 20;">
                            <Label fx:id="appearanceTitleLabel" text="Appearance" style="-fx-font-size: 17px;                                        -fx-font-weight: bold;                                        " styleClass="ui-text" />
                            <Separator />
                            <ResponsiveRow alignment="CENTER_LEFT">
                                <VBox spacing="3">
                                    <Label fx:id="darkModeLabel" text="Dark Mode" style="-fx-font-weight: bold;" />
                                    <Label fx:id="darkModeDescriptionLabel" text="Use dark application theme" style="-fx-font-size: 11px;                                                " styleClass="ui-muted" />
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <ToggleButton fx:id="darkModeToggle" text="OFF" />
                            </ResponsiveRow>
                        </VBox>
                        <VBox spacing="15" style="-fx-background-color: white;                                    -fx-background-radius: 10;                                    -fx-padding: 20;">
                            <Label fx:id="securityTitleLabel" text="Security" style="-fx-font-size: 17px;                                        -fx-font-weight: bold;                                        " styleClass="ui-text" />
                            <Separator />
                            <PasswordField fx:id="currentPasswordField" promptText="Current Password" />
                            <PasswordField fx:id="newPasswordField" promptText="New Password" />
                            <PasswordField fx:id="confirmPasswordField" promptText="Confirm Password" />
                            <Button fx:id="changePasswordButton" text="Change Password" maxWidth="Infinity" style="-fx-padding: 9; -fx-cursor: hand;" styleClass="neutral-button" />
                            <Separator />
                            <Label text="System Administration" style="-fx-font-size: 12px;                                        -fx-font-weight: bold;                                        " styleClass="ui-muted" />
                            <Button fx:id="programLicenseButton" text="Program License 🔒" maxWidth="Infinity" style="-fx-padding: 10; -fx-cursor: hand;" styleClass="primary-button" />
                            <Button fx:id="databaseConfigurationButton" text="Database Configuration 🔒" maxWidth="Infinity" style="-fx-padding: 10; -fx-cursor: hand;" styleClass="neutral-button" />
                        </VBox>
                        <VBox spacing="15" style="-fx-background-color: white;                                    -fx-background-radius: 10;                                    -fx-padding: 20;">
                            <Label fx:id="backupTitleLabel" text="Data &amp; Backup" style="-fx-font-size: 17px;                                        -fx-font-weight: bold;                                        " styleClass="ui-text" />
                            <Separator />
                            <Label fx:id="lastBackupLabel" text="Last backup: Today, 10:30 AM" style="-fx-font-size: 12px;                                        " styleClass="ui-muted" />
                            <Button fx:id="backupDatabaseButton" text="Backup Database" maxWidth="Infinity" style="-fx-padding: 9; -fx-cursor: hand;" styleClass="primary-button" />
                            <Button fx:id="restoreBackupButton" text="Restore Backup" maxWidth="Infinity" style="-fx-padding: 9; -fx-cursor: hand;" styleClass="secondary-button" />
                        </VBox>
                    </VBox>
                </ResponsiveRow>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
