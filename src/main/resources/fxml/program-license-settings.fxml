<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import com.mycompany.lazar_app.ui.ResponsiveRow?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" prefWidth="620" prefHeight="520" fx:controller="com.mycompany.lazar_app.controller.ProgramLicenseSettingsController" style="-fx-background-color: #F8FAFC;" styleClass=" responsive-form" minWidth="0" minHeight="0">
    <top>
        <VBox spacing="6" styleClass=" form-header">
            <Label fx:id="titleLabel" text="GymFlow Program License" style="-fx-font-size: 23px;                        -fx-font-weight: bold;                        " styleClass="ui-text" />
            <Label fx:id="subtitleLabel" text="These settings are available to the Super Admin only." wrapText="true" style="-fx-font-size: 12px;                        " styleClass="ui-muted" />
        </VBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" minWidth="0" minHeight="0" styleClass="responsive-content">
            <content>
                <VBox fx:id="rootContainer" spacing="18" style="-fx-background-color: #F8FAFC;">
                    <padding>
                        <Insets top="24" right="26" bottom="24" left="26" />
                    </padding>
                    <VBox spacing="8" style="-fx-background-color: white;                    -fx-background-radius: 10;                    -fx-padding: 15;                    -fx-border-color: #E2E8F0;                    -fx-border-radius: 10;">
                        <Label fx:id="statusTitleLabel" text="License Status" style="-fx-font-weight: bold;                        " styleClass="ui-text" />
                        <Label fx:id="statusValueLabel" text="-" wrapText="true" />
                    </VBox>
                    <VBox spacing="14" VBox.vgrow="ALWAYS" style="-fx-background-color: white;                    -fx-background-radius: 10;                    -fx-padding: 18;                    -fx-border-color: #E2E8F0;                    -fx-border-radius: 10;">
                        <VBox spacing="6">
                            <Label fx:id="termLabel" text="Program Term" style="-fx-font-weight: bold;                            " styleClass="ui-text" />
                            <ComboBox fx:id="termComboBox" maxWidth="Infinity" prefHeight="38" />
                        </VBox>
                        <ResponsiveRow spacing="12">
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label fx:id="fromLabel" text="From Date" style="-fx-font-weight: bold;                                " styleClass="ui-text" />
                                <DatePicker fx:id="fromDatePicker" maxWidth="Infinity" prefHeight="38" />
                            </VBox>
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label fx:id="toLabel" text="To Date" style="-fx-font-weight: bold;                                " styleClass="ui-text" />
                                <DatePicker fx:id="toDatePicker" maxWidth="Infinity" prefHeight="38" />
                            </VBox>
                        </ResponsiveRow>
                        <Separator />
                        <VBox spacing="6">
                            <Label fx:id="passwordLabel" text="Super Admin Password" style="-fx-font-weight: bold;                            " styleClass="ui-text" />
                            <PasswordField fx:id="superAdminPasswordField" promptText="Enter Super Admin password to activate" prefHeight="38" />
                        </VBox>
                        <Label fx:id="messageLabel" text="" wrapText="true" />
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <ResponsiveRow spacing="10" alignment="CENTER_RIGHT" styleClass=" persistent-actions">
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="cancelButton" text="Cancel" prefWidth="145" style="-fx-padding: 10 16; -fx-cursor: hand;" styleClass="secondary-button" />
            <Button fx:id="activateButton" text="Save &amp; Activate" prefWidth="190" style="-fx-padding: 10 16; -fx-cursor: hand;" styleClass="primary-button" />
        </ResponsiveRow>
    </bottom>
</BorderPane>
