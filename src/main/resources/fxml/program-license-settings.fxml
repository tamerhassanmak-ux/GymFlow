<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox
        fx:id="rootContainer"
        spacing="18"
        prefWidth="620"
        prefHeight="520"
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.mycompany.lazar_app.controller.ProgramLicenseSettingsController"
        style="-fx-background-color: #F8FAFC;">

    <padding>
        <Insets top="24" right="26" bottom="24" left="26"/>
    </padding>

    <VBox spacing="6">
        <Label
                fx:id="titleLabel"
                text="GymFlow Program License"
                style="-fx-font-size: 23px;
                       -fx-font-weight: bold;
                       -fx-text-fill: #111827;"/>

        <Label
                fx:id="subtitleLabel"
                text="These settings are available to the Super Admin only."
                wrapText="true"
                style="-fx-font-size: 12px;
                       -fx-text-fill: #64748B;"/>
    </VBox>

    <VBox
            spacing="8"
            style="-fx-background-color: white;
                   -fx-background-radius: 10;
                   -fx-padding: 15;
                   -fx-border-color: #E2E8F0;
                   -fx-border-radius: 10;">

        <Label
                fx:id="statusTitleLabel"
                text="License Status"
                style="-fx-font-weight: bold;
                       -fx-text-fill: #334155;"/>

        <Label
                fx:id="statusValueLabel"
                text="-"
                wrapText="true"/>
    </VBox>

    <VBox
            spacing="14"
            VBox.vgrow="ALWAYS"
            style="-fx-background-color: white;
                   -fx-background-radius: 10;
                   -fx-padding: 18;
                   -fx-border-color: #E2E8F0;
                   -fx-border-radius: 10;">

        <VBox spacing="6">
            <Label
                    fx:id="termLabel"
                    text="Program Term"
                    style="-fx-font-weight: bold;
                           -fx-text-fill: #374151;"/>

            <ComboBox
                    fx:id="termComboBox"
                    maxWidth="Infinity"
                    prefHeight="38"/>
        </VBox>

        <HBox spacing="12">

            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label
                        fx:id="fromLabel"
                        text="From Date"
                        style="-fx-font-weight: bold;
                               -fx-text-fill: #374151;"/>

                <DatePicker
                        fx:id="fromDatePicker"
                        maxWidth="Infinity"
                        prefHeight="38"/>
            </VBox>

            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label
                        fx:id="toLabel"
                        text="To Date"
                        style="-fx-font-weight: bold;
                               -fx-text-fill: #374151;"/>

                <DatePicker
                        fx:id="toDatePicker"
                        maxWidth="Infinity"
                        prefHeight="38"/>
            </VBox>

        </HBox>

        <Separator/>

        <VBox spacing="6">
            <Label
                    fx:id="passwordLabel"
                    text="Super Admin Password"
                    style="-fx-font-weight: bold;
                           -fx-text-fill: #374151;"/>

            <PasswordField
                    fx:id="superAdminPasswordField"
                    promptText="Enter Super Admin password to activate"
                    prefHeight="38"/>
        </VBox>

        <Label
                fx:id="messageLabel"
                text=""
                wrapText="true"/>
    </VBox>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Region HBox.hgrow="ALWAYS"/>

        <Button
                fx:id="cancelButton"
                text="Cancel"
                prefWidth="145"
                style="-fx-background-color: white;
                       -fx-text-fill: #374151;
                       -fx-border-color: #CBD5E1;
                       -fx-border-radius: 7;
                       -fx-background-radius: 7;
                       -fx-padding: 10 16;
                       -fx-font-weight: bold;
                       -fx-cursor: hand;"/>

        <Button
                fx:id="activateButton"
                text="Save &amp; Activate"
                prefWidth="190"
                style="-fx-background-color: #F97316;
                       -fx-text-fill: white;
                       -fx-background-radius: 7;
                       -fx-padding: 10 16;
                       -fx-font-weight: bold;
                       -fx-cursor: hand;"/>
    </HBox>

</VBox>
