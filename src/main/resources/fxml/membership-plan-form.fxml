<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        prefWidth="760.0"
        prefHeight="650.0"
        minWidth="640.0"
        minHeight="520.0"
        maxWidth="Infinity"
        maxHeight="Infinity"
        style="-fx-background-color:#FFFFFF;"
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.mycompany.lazar_app.controller.MembershipPlanFormController">

    <!-- =====================================================
         FIXED HEADER
    ====================================================== -->
    <top>
        <VBox spacing="14"
              style="-fx-background-color:#FFFFFF;">

            <padding>
                <Insets top="24" right="30" bottom="14" left="30"/>
            </padding>

            <Label
                    fx:id="titleLabel"
                    text="Membership Plan"
                    styleClass="page-title"/>

            <Separator/>

        </VBox>
    </top>


    <!-- =====================================================
         SCROLLABLE FORM BODY ONLY
    ====================================================== -->
    <center>
        <ScrollPane
                fx:id="formScrollPane"
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                pannable="false"
                style="-fx-background-color:transparent; -fx-background:#FFFFFF;">

            <content>
                <VBox
                        spacing="20"
                        maxWidth="Infinity"
                        style="-fx-background-color:#FFFFFF;">

                    <padding>
                        <Insets top="8" right="30" bottom="22" left="30"/>
                    </padding>

                    <!-- =================================================
                         BASIC PLAN DATA
                    ================================================== -->
                    <GridPane
                            hgap="20"
                            vgap="8"
                            maxWidth="Infinity">

                        <columnConstraints>
                            <ColumnConstraints
                                    percentWidth="50"
                                    hgrow="ALWAYS"
                                    fillWidth="true"/>
                            <ColumnConstraints
                                    percentWidth="50"
                                    hgrow="ALWAYS"
                                    fillWidth="true"/>
                        </columnConstraints>

                        <children>

                            <!-- CODE -->
                            <VBox
                                    spacing="7"
                                    maxWidth="Infinity"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="0">

                                <Label
                                        fx:id="codeLabel"
                                        text="Code"
                                        styleClass="form-label"/>

                                <TextField
                                        fx:id="codeField"
                                        prefHeight="44"
                                        maxWidth="Infinity"/>

                            </VBox>

                            <!-- STATUS -->
                            <VBox
                                    spacing="7"
                                    maxWidth="Infinity"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="0">

                                <Label
                                        fx:id="statusLabel"
                                        text="Status"
                                        styleClass="form-label"/>

                                <ComboBox
                                        fx:id="statusComboBox"
                                        prefHeight="44"
                                        maxWidth="Infinity"/>

                            </VBox>


                            <!-- ARABIC NAME -->
                            <VBox
                                    spacing="7"
                                    maxWidth="Infinity"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="1">

                                <Label
                                        fx:id="nameArLabel"
                                        text="Arabic Name"
                                        styleClass="form-label"/>

                                <TextField
                                        fx:id="nameArField"
                                        prefHeight="44"
                                        maxWidth="Infinity"/>

                            </VBox>

                            <!-- ENGLISH NAME -->
                            <VBox
                                    spacing="7"
                                    maxWidth="Infinity"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="1">

                                <Label
                                        fx:id="nameEnLabel"
                                        text="English Name"
                                        styleClass="form-label"/>

                                <TextField
                                        fx:id="nameEnField"
                                        prefHeight="44"
                                        maxWidth="Infinity"/>

                            </VBox>


                            <!-- DURATION -->
                            <VBox
                                    spacing="7"
                                    maxWidth="Infinity"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="2">

                                <Label
                                        fx:id="durationLabel"
                                        text="Duration (Months)"
                                        styleClass="form-label"/>

                                <TextField
                                        fx:id="durationField"
                                        prefHeight="44"
                                        maxWidth="Infinity"
                                        promptText="Example: 1"/>

                            </VBox>

                            <!-- MAX SESSIONS -->
                            <VBox
                                    spacing="7"
                                    maxWidth="Infinity"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="2">

                                <Label
                                        fx:id="maxSessionsLabel"
                                        text="Max Sessions"
                                        styleClass="form-label"/>

                                <TextField
                                        fx:id="maxSessionsField"
                                        prefHeight="44"
                                        maxWidth="Infinity"
                                        promptText="Example: 12"/>

                            </VBox>


                            <!-- PRICE -->
                            <VBox
                                    spacing="7"
                                    maxWidth="Infinity"
                                    GridPane.columnIndex="0"
                                    GridPane.columnSpan="2"
                                    GridPane.rowIndex="3">

                                <Label
                                        fx:id="priceLabel"
                                        text="Price"
                                        styleClass="form-label"/>

                                <TextField
                                        fx:id="priceField"
                                        prefHeight="44"
                                        maxWidth="Infinity"
                                        promptText="Example: 500"/>

                            </VBox>

                        </children>
                    </GridPane>


                    <Separator/>


                    <!-- =================================================
                         DESCRIPTION
                    ================================================== -->
                    <VBox
                            spacing="8"
                            maxWidth="Infinity">

                        <Label
                                fx:id="descriptionLabel"
                                text="Description"
                                styleClass="form-label"/>

                        <TextArea
                                fx:id="descriptionArea"
                                wrapText="true"
                                prefHeight="130"
                                minHeight="110"
                                maxWidth="Infinity"/>

                    </VBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>


    <!-- =====================================================
         FIXED ACTION BAR
    ====================================================== -->
    <bottom>
        <VBox
                spacing="0"
                style="-fx-background-color:#FFFFFF;">

            <Separator/>

            <HBox
                    spacing="12"
                    alignment="CENTER_RIGHT">

                <padding>
                    <Insets top="16" right="30" bottom="20" left="30"/>
                </padding>

                <Region HBox.hgrow="ALWAYS"/>

                <Button
                        fx:id="cancelButton"
                        text="Cancel"
                        prefWidth="120"
                        prefHeight="44"
                        onAction="#cancel"
                        styleClass="secondary-button"/>

                <Button
                        fx:id="saveButton"
                        text="Save"
                        prefWidth="155"
                        prefHeight="44"
                        onAction="#save"
                        styleClass="primary-button"/>

            </HBox>

        </VBox>
    </bottom>

</BorderPane>
