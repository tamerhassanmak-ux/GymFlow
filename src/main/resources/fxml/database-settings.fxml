<?xml version="1.0" encoding="UTF-8"?>
<?import com.mycompany.lazar_app.ui.ResponsiveRow?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>



  <BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.lazar_app.controller.DatabaseSettingsController"
            prefWidth="1000"
            prefHeight="700"
            minWidth="0"
            minHeight="0" styleClass="app-page"
            >
    <top>
        <VBox spacing="5" style="-fx-background-color: white;">
            <padding><Insets top="22" right="30" bottom="22" left="30"/></padding>
            <Label styleClass="ui-text" text="%database.title"
                   style="-fx-font-size: 25px; -fx-font-weight: bold; "/>
            <Label styleClass="ui-text" text="%database.subtitle"/>
        </VBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <content>
                <VBox spacing="18">
                    <padding><Insets top="28" right="35" bottom="28" left="35"/></padding>

                    <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 22; -fx-background-radius: 10;">
                        <Label styleClass="ui-text" text="%database.engine" style="-fx-font-size: 17px; -fx-font-weight: bold;"/>
                        <ComboBox fx:id="databaseTypeCombo" maxWidth="Infinity" prefHeight="42"/>
                    </VBox>

                    <VBox fx:id="sqlitePane" spacing="10"
                          style="-fx-background-color: white; -fx-padding: 22; -fx-background-radius: 10;">
                        <Label styleClass="ui-text" text="%database.sqlite" style="-fx-font-size: 17px; -fx-font-weight: bold;"/>
                        <ResponsiveRow spacing="10">
                            <TextField fx:id="sqlitePathField" HBox.hgrow="ALWAYS"/>
                            <Button text="%database.browse" onAction="#handleBrowse"/>
                        </ResponsiveRow>
                    </VBox>

                    <VBox fx:id="serverPane" spacing="14"
                          style="-fx-background-color: white; -fx-padding: 22; -fx-background-radius: 10;">
                        <Label styleClass="ui-text" text="%database.server" style="-fx-font-size: 17px; -fx-font-weight: bold;"/>
                        <ResponsiveRow spacing="12">
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label styleClass="ui-text" text="%database.host"/>
                                <TextField fx:id="hostField"/>
                            </VBox>
                            <VBox spacing="5" prefWidth="160">
                                <Label styleClass="ui-text" text="%database.port"/>
                                <TextField fx:id="portField"/>
                            </VBox>
                        </ResponsiveRow>
                        <VBox spacing="5">
                            <Label styleClass="ui-text" text="%database.name"/>
                            <TextField fx:id="databaseNameField"/>
                        </VBox>
                        <ResponsiveRow spacing="12">
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label styleClass="ui-text" text="%database.username"/>
                                <TextField fx:id="usernameField"/>
                            </VBox>
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label styleClass="ui-text" text="%database.password"/>
                                <PasswordField fx:id="passwordField"/>
                            </VBox>
                        </ResponsiveRow>
                        <CheckBox fx:id="platformCredentialCheckBox" text="%database.platformCredentials"/>
                        <CheckBox fx:id="encryptCheckBox" text="%database.encrypt"/>
                        <Label text="%database.tlsPolicy" wrapText="true"/>
                        <Label text="%database.truststore"/>
                        <TextField fx:id="trustStoreField"/>
                        <ComboBox fx:id="trustStoreTypeCombo"/>
                        <Label text="%database.truststorePassword"/>
                        <PasswordField fx:id="trustStorePasswordField"/>
                        <Label text="%database.rsaPublicKey"/>
                        <TextField fx:id="rsaPublicKeyField"/>
                    </VBox>

                    <Label styleClass="ui-text" fx:id="statusLabel" wrapText="true"/>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <ResponsiveRow spacing="10" alignment="CENTER_RIGHT"
              style="-fx-background-color: white; -fx-padding: 18 30;">
            <Button fx:id="testButton" text="%database.test" onAction="#handleTestConnection"/>
            <Button fx:id="saveButton" text="%database.save" onAction="#handleSave"
                     styleClass="primary-button"/>
        </ResponsiveRow>
    </bottom>
</BorderPane>
