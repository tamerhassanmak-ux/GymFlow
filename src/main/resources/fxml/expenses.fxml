<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        fx:id="rootPane"
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.mycompany.lazar_app.controller.ExpensesController"
        prefWidth="1200"
        prefHeight="750"
        style="-fx-background-color: #f5f7fb;">

    <center>

        <VBox spacing="20">

            <padding>
                <Insets
                        top="25"
                        right="25"
                        bottom="25"
                        left="25"/>
            </padding>

            <!-- =============================================== -->
            <!-- HEADER -->
            <!-- =============================================== -->

            <HBox
                    alignment="CENTER_LEFT"
                    spacing="15">

                <VBox spacing="4">

                    <Label
                            fx:id="pageTitleLabel"
                            style="
                                -fx-font-size: 26px;
                                -fx-font-weight: bold;
                                -fx-text-fill: #172033;
                            "/>

                    <Label
                            fx:id="pageSubtitleLabel"
                            style="
                                -fx-font-size: 13px;
                                -fx-text-fill: #6b7280;
                            "/>

                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button
                        fx:id="refreshButton"
                        onAction="#refreshAll"
                        style="
                            -fx-background-color: white;
                            -fx-border-color: #d7dce5;
                            -fx-border-radius: 8;
                            -fx-background-radius: 8;
                            -fx-padding: 10 18;
                        "/>

                <Button
                        fx:id="newExpenseButton"
                        onAction="#handleNewExpense"
                        style="
                            -fx-background-color: #2563eb;
                            -fx-text-fill: white;
                            -fx-font-weight: bold;
                            -fx-background-radius: 8;
                            -fx-padding: 11 20;
                        "/>

            </HBox>

            <!-- =============================================== -->
            <!-- KPI CARDS -->
            <!-- =============================================== -->

            <HBox spacing="15">

                <VBox
                        spacing="8"
                        HBox.hgrow="ALWAYS"
                        style="
                            -fx-background-color: white;
                            -fx-background-radius: 12;
                            -fx-padding: 18;
                        ">

                    <Label
                            fx:id="totalExpensesTitleLabel"
                            style="-fx-text-fill: #6b7280;"/>

                    <Label
                            fx:id="totalExpensesLabel"
                            text="0.00"
                            style="
                                -fx-font-size: 22px;
                                -fx-font-weight: bold;
                            "/>

                </VBox>

                <VBox
                        spacing="8"
                        HBox.hgrow="ALWAYS"
                        style="
                            -fx-background-color: white;
                            -fx-background-radius: 12;
                            -fx-padding: 18;
                        ">

                    <Label
                            fx:id="monthExpensesTitleLabel"
                            style="-fx-text-fill: #6b7280;"/>

                    <Label
                            fx:id="monthExpensesLabel"
                            text="0.00"
                            style="
                                -fx-font-size: 22px;
                                -fx-font-weight: bold;
                            "/>

                </VBox>

                <VBox
                        spacing="8"
                        HBox.hgrow="ALWAYS"
                        style="
                            -fx-background-color: white;
                            -fx-background-radius: 12;
                            -fx-padding: 18;
                        ">

                    <Label
                            fx:id="pendingExpensesTitleLabel"
                            style="-fx-text-fill: #6b7280;"/>

                    <Label
                            fx:id="pendingExpensesLabel"
                            text="0.00"
                            style="
                                -fx-font-size: 22px;
                                -fx-font-weight: bold;
                            "/>

                </VBox>

                <VBox
                        spacing="8"
                        HBox.hgrow="ALWAYS"
                        style="
                            -fx-background-color: white;
                            -fx-background-radius: 12;
                            -fx-padding: 18;
                        ">

                    <Label
                            fx:id="transactionsTitleLabel"
                            style="-fx-text-fill: #6b7280;"/>

                    <Label
                            fx:id="transactionsCountLabel"
                            text="0"
                            style="
                                -fx-font-size: 22px;
                                -fx-font-weight: bold;
                            "/>

                </VBox>

            </HBox>

            <!-- =============================================== -->
            <!-- SEARCH + FILTERS -->
            <!-- =============================================== -->

            <HBox
                    spacing="10"
                    alignment="CENTER_LEFT">

                <TextField
                        fx:id="searchField"
                        prefWidth="330"
                        style="
                            -fx-background-radius: 8;
                            -fx-padding: 10;
                        "/>

                <ComboBox
                        fx:id="categoryFilter"
                        prefWidth="170"/>

                <ComboBox
                        fx:id="statusFilter"
                        prefWidth="150"/>

                <Button
                        fx:id="resetButton"
                        onAction="#handleResetFilters"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button
                        fx:id="editButton"
                        onAction="#handleEditExpense"
                        style="
                            -fx-background-color: #f59e0b;
                            -fx-text-fill: white;
                            -fx-background-radius: 7;
                            -fx-padding: 9 18;
                        "/>

                <Button
                        fx:id="deleteButton"
                        onAction="#handleDeleteExpense"
                        style="
                            -fx-background-color: #dc2626;
                            -fx-text-fill: white;
                            -fx-background-radius: 7;
                            -fx-padding: 9 18;
                        "/>

            </HBox>

            <!-- =============================================== -->
            <!-- TABLE -->
            <!-- =============================================== -->

            <TableView
                    fx:id="expensesTable"
                    VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn
                            fx:id="codeColumn"
                            prefWidth="110"/>

                    <TableColumn
                            fx:id="titleColumn"
                            prefWidth="180"/>

                    <TableColumn
                            fx:id="categoryColumn"
                            prefWidth="130"/>

                    <TableColumn
                            fx:id="amountColumn"
                            prefWidth="110"/>

                    <TableColumn
                            fx:id="dateColumn"
                            prefWidth="110"/>

                    <TableColumn
                            fx:id="paymentMethodColumn"
                            prefWidth="120"/>

                    <TableColumn
                            fx:id="beneficiaryColumn"
                            prefWidth="150"/>

                    <TableColumn
                            fx:id="statusColumn"
                            prefWidth="100"/>

                </columns>

            </TableView>

        </VBox>

    </center>

</BorderPane>