<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.mycompany.lazar_app.controller.SuperAdminSetupController"
    prefWidth="500"
    spacing="16"
    style="-fx-background-color: white;">

    <padding>
        <Insets
            top="30"
            right="32"
            bottom="30"
            left="32"/>
    </padding>

    <Label styleClass="ui-text"
        text="%setup.title"
        style="
            -fx-font-size: 24px;
            -fx-font-weight: bold;

        "/>

    <Label styleClass="ui-text"
        text="%setup.description"
        wrapText="true"/>

    <Label styleClass="ui-text"
        text="%setup.password"
        style="-fx-font-weight: bold;"/>

    <PasswordField
        fx:id="passwordField"
        promptText="%setup.minimum"
        prefHeight="42"/>

    <Label styleClass="ui-text"
        text="%setup.confirm"
        style="-fx-font-weight: bold;"/>

    <PasswordField
        fx:id="confirmPasswordField"
        promptText="%setup.reenter"
        prefHeight="42"/>

    <Label styleClass="ui-text"
        fx:id="messageLabel"
        wrapText="true"
        style="-fx-text-fill: #DC2626;"/>

    <HBox alignment="CENTER_RIGHT">

        <Button
            text="%setup.save"
            defaultButton="true"
            onAction="#handleSave"
            style="-fx-padding: 10 22;" styleClass="primary-button"/>

    </HBox>

</VBox>